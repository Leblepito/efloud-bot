# ─────────────────────────────────────────────────────────────────
# Dockerfile.kronos — Kronos cascade runner (P-Kronos-Social)
#
# Ayrı image: torch (~1.8GB CPU wheel) ana bot image'ına GİRMEZ.
# `docker compose run --rm kronos-runner` cron'dan 4 saatte bir koşar,
# data/market/kronos_cascade.json'u efloud_data volume'una yazar;
# routines-watcher'daki social_content rutini bu dosyayı okur.
#
# Build (VPS):
#   docker compose -f docker-compose.prod.yml build kronos-runner
# İlk koşuda model (~500MB) HuggingFace'ten iner → kronos_hf_cache
# volume'unda kalıcıdır, sonraki koşular indirmez.
# ─────────────────────────────────────────────────────────────────
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/hf_cache \
    KRONOS_EXEC_MODE=direct \
    KRONOS_SKILL_DIR=/app/.claude/skills/kronos

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Torch CPU wheel'i (CUDA'sız — VPS'te GPU yok, image yarıya iner).
RUN pip install --index-url https://download.pytorch.org/whl/cpu "torch>=2.0" \
    && pip install "transformers>=4.40" "huggingface-hub>=0.20" \
       "yfinance>=0.2.40" "pandas>=2.0" "numpy>=1.24" "einops>=0.7" \
       "safetensors>=0.4" "pyyaml>=6.0"

# Kronos foundation-model repo'su image'a pişirilir (runtime klon yok).
RUN git clone --depth 1 https://github.com/shiyu-coder/Kronos \
    /app/.claude/skills/kronos/_kronos

# Skill script'leri + servis + config (sembol/profil kaynağı).
COPY .claude/skills/kronos/scripts/ /app/.claude/skills/kronos/scripts/
COPY scripts/kronos_service.py /app/scripts/kronos_service.py
COPY config.yaml /app/config.yaml

CMD ["python", "-m", "scripts.kronos_service"]
