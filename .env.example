# efloud-bot — kopyala: cp .env.example .env  (gerçek değerleri sadece .env'e yaz, commit'leme)

# Binance USDT-M Futures API (testnet için: https://testnet.binancefuture.com)
BINANCE_API_KEY=<BINANCE_API_KEY>
BINANCE_API_SECRET=<BINANCE_API_SECRET>

# Config seçimi
#   configs/config.testnet.yaml     → testnet (önerilen ilk kurulum)
#   configs/config.phase2_1k.yaml   → mainnet canlı (EFLOUD_ALLOW_MAINNET=1 gerekir)
EFLOUD_CONFIG_PATH=configs/config.testnet.yaml
EFLOUD_ALLOW_MAINNET=0
EFLOUD_AUTOSTART=0
EFLOUD_AUTO_MIGRATE=0

# Dashboard girişi
DASHBOARD_PASSWORD=<GUCLU_BIR_SIFRE>
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=<RASTGELE_UZUN_DEGER>
ALLOWED_ORIGINS=http://localhost:8080
ENV=dev
LOG_LEVEL=INFO

# Opsiyonel: Postgres (boş bırakılırsa geçmiş işlemler state/trade_journal.jsonl'den okunur)
DATABASE_URL=

# Opsiyonel: Telegram bildirimleri
EFLOUD_TELEGRAM_TOKEN=
EFLOUD_TELEGRAM_CHAT_ID=

# Opsiyonel: danışma (advisory) LLM katmanı — agent team + sentiment + structure validation
# Sağlayıcı config'ten gelir (config.yaml → agent_team / llm) veya LLM_PROVIDER env'inden.
# Varsayılan/aktif: openrouter + deepseek/deepseek-v4.1-flash (tek anahtar, tüm modeller).
# Anahtar YOKSA katman sessizce {} döner (bot çalışır, ama kararlar boş kalır).
OPENROUTER_API_KEY=
# Global sağlayıcı anahtarı — config'teki provider yazılıysa config kazanır.
# LLM_PROVIDER=openrouter

# Opsiyonel: sosyal medya pipeline'ı (varsayılan kapalı)
SOCIAL_CONTENT_ENABLED=0
SOCIAL_AUTOPILOT=0
