# Efloud Bot — Environment Variables Template
# Bu dosyayı `.env` olarak kopyala, kendi değerlerini yaz.
# Copy to `.env` and fill in your own values.
#
# Windows PowerShell:
#   Copy-Item .env.example .env
#   notepad .env     # düzenle
#
# .env dosyası .gitignore'da — asla commit edilmez.

# Binance API credentials (Testnet veya Mainnet)
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# Mainnet LIVE trading için zorunlu (testnet'te gerekli değil)
# EFLOUD_ALLOW_MAINNET=1
