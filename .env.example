# Efloud Bot — Environment Variables
# Local dev: copy to `.env`. Production (Railway): set in Railway project Variables.

# ── Bot core (CLI + worker mode) ──
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
EFLOUD_ALLOW_MAINNET=1                    # required for live mainnet trading

# Hangi config dosyası kullanılsın (default: configs/config.phase2_micro.yaml)
# Mainnet için: configs/config.phase2_1k.yaml
EFLOUD_CONFIG_PATH=configs/config.phase2_micro.yaml

# Bot lifecycle:
#   1 = FastAPI başlangıcında bot otomatik başlar (dev için pratik)
#   0 = Bot stopped başlar, dashboard'dan manuel /api/bot/start ile başlat (prod önerilir)
EFLOUD_AUTOSTART=1

# DB schema migration:
#   1 = FastAPI başlangıcında pending migration'lar otomatik uygulanır (ilk deploy için 1 yap)
#   0 = Manuel: `python -m backend.migrate up`
EFLOUD_AUTO_MIGRATE=0

# ── Web platform (FastAPI backend on Railway) ──
DASHBOARD_PASSWORD=set-a-strong-password-32-chars-min
SESSION_SECRET=random-32-char-string-for-cookie-signing

# Supabase Postgres (Connection Pooler URL — port 6543)
DATABASE_URL=postgresql://postgres:PASS@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# CORS — comma-separated list of frontend origins
# Single-service deploy'da (frontend FastAPI tarafından serve edilir) sadece kendi domain'iniz yeterli
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://your-app.up.railway.app

# Production prod settings (Railway sets ENV=production)
ENV=dev
LOG_LEVEL=INFO

# ── Railway Deploy (CLI / API) ──
# Bu repo iki Railway servisi deploy eder:
#   1) Bot/dashboard  → kök railway.json (DOCKERFILE, healthcheck "/")
#   2) Pazarlama sitesi → u2algo-site/railway.json (NIXPACKS, "node server.js")
#
# CLI deploy için:  railway login  →  railway link  →  railway up
# Token'ları SADECE lokal .env'e koy (gitignored). Buraya GERÇEK değer yazma.
RAILWAY_CLIENT_ID=rlwy_oaci_xxxxxxxxxxxxxxxxxxxx   # operatör tarafından verilen public client-id
RAILWAY_TOKEN=                                     # gizli deploy/project token — Railway → Settings → Tokens
RAILWAY_API_TOKEN=                                 # opsiyonel: account-level API token
