# Claude Code local state — drift per session, never commit
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/projects/

# Local working dirs / venv variations
.tmp/
tmp/

# Git worktrees (isolated workspaces for parallel work, never committed)
.worktrees/
worktrees/

# Cloned external reference repositories — ignored EXCEPT the Kronos skill's
# runner scripts + requirements, which the bot's Binance-native Kronos feed
# depends on (the --df-path patch). Heavy/generated parts (.venv, _kronos clone,
# __pycache__) stay ignored and are rebuilt by the runner's ensure_venv() on the VPS.
external_repos/*
!external_repos/kronos-claude-skill/
external_repos/kronos-claude-skill/*
!external_repos/kronos-claude-skill/scripts/
!external_repos/kronos-claude-skill/requirements.txt
external_repos/kronos-claude-skill/scripts/*
!external_repos/kronos-claude-skill/scripts/*.py

# Local candidate configs
configs/candidate_*.yaml

# Graphify — derived AST knowledge graph (auto-regenerated by the
# post-commit hook). Committing the regenerated JSON triggers a 50+ MB
# diff churn on every PR. Keep the artefact on disk, out of git.
# See PR header for the original analysis (53.6 MB graph.json).
graphify-out/


.env.supabase
node_modules

