# u2algo-site environment template
# Copy to .env (local dev) or set in Railway dashboard (production)
# NEVER commit actual secret values — only key names go here.

# ===== Server =====
NODE_ENV=production
PORT=3000
# Public site URL (used for canonical links, OG tags, sitemap)
SITE_URL=https://u2algo.com
# Dashboard URL (link target for logged-in users)
DASHBOARD_URL=https://bot.u2algo.com

# ===== Supabase (waitlist + entitlements) =====
# Server-side only. Do NOT prefix with PUBLIC_ — these never go to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Lemon Squeezy (T-016) =====
# Webhook secret from LS dashboard → Settings → Webhooks
# Used to verify HMAC-SHA256 signature on incoming webhooks
# ASLA commit edilmez — sadece Railway dashboard'dan set edilir
LEMONSQUEEZY_WEBHOOK_SECRET=
# Store identifier (LS dashboard URL'inde görünür)
LEMONSQUEEZY_STORE_ID=
# PREMIUM product = the wave1 INDICATOR (TradingView invite-only access).
# 2026-06-15 pivot: indicator-as-premium (Wave-1 STRATEGY NO-GO → R&D backlog).
LEMONSQUEEZY_INDICATOR_PRODUCT_ID=
# Strategy script is NOT sold yet (Wave-2 redesign in R&D). Placeholder kept for a
# future greenlight; leave empty until then.
LEMONSQUEEZY_STRATEGY_PRODUCT_ID=

# ===== Resend transactional email (T-016, T-019) =====
# API key from https://resend.com/api-keys
# Sender domain must have SPF/DKIM/DMARC configured (B.4 kararı)
RESEND_API_KEY=
# "From" address for transactional emails
RESEND_FROM_EMAIL=noreply@u2algo.com
# "From" name (e.g. "u2algo")
RESEND_FROM_NAME=u2algo
# Customer support address (T-019 quickstart'ta gösterilir)
SUPPORT_EMAIL=support@u2algo.com

# ===== Status page (T-021) =====
# Public status page URL (UptimeRobot statuspage.com subdomain veya custom domain)
STATUS_PAGE_URL=https://efloud-bot.statuspage.com

# ===== Session / Cookie security =====
# 32+ char random string. Used to sign session cookies.
SESSION_SECRET=
# "secure" flag on cookies — true in production (HTTPS), false in local dev
COOKIE_SECURE=true

# ===== Feature flags =====
# WAITLIST_OPEN=false → waitlist form 503 döner (launch öncesi)
WAITLIST_OPEN=true
# ENTITLEMENTS_ENABLED=false → entitlement checkleri bypass (W2 öncesi dev)
ENTITLEMENTS_ENABLED=false
# TELEGRAM_NOTIFIER_DEFAULT=false → telegram bildirimleri kapalı (T-018)
TELEGRAM_NOTIFIER_DEFAULT=false
