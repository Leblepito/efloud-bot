# Testnet config sablonu - Binance testnet API keys (secret DEGERLERI icermez)
# Kullanim: bu dosyayi .env.testnet olarak kopyalayip degerleri doldurun.
BINANCE_API_KEY=<BINANCE_TESTNET_API_KEY>
BINANCE_API_SECRET=<BINANCE_TESTNET_API_SECRET>
EFLOUD_ALLOW_MAINNET=0
EFLOUD_CONFIG_PATH=configs/config.testnet.yaml
DASHBOARD_PASSWORD=<DASHBOARD_PASSWORD>
SESSION_SECRET=<SESSION_SECRET_32_CHARS>
EFLOUD_AUTOSTART=0
EFLOUD_AUTO_MIGRATE=1
ENV=dev
LOG_LEVEL=INFO

# Database (disabled for local testnet - bot runs without persistence)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/efloud

# Social publishing (disabled by default)
SOCIAL_CONTENT_ENABLED=0
SOCIAL_AUTOPILOT=0
SOCIAL_LANGS=en
SOCIAL_PLATFORMS=x

# Kronos (disabled)
KRONOS_SYMBOLS=BTC,ETH,SOL
KRONOS_RUNS_PER_LAYER=3
KRONOS_OUTPUT_PATH=data/market/kronos_cascade.json

# X/Twitter (disabled)
X_API_ENABLED=false

# Instagram (disabled)
INSTAGRAM_ENABLED=false
