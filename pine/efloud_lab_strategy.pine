//@version=6
// GENERATED by scripts/build_pine_lab.py — edit pine/lab/*, never this file.
// EFloud Lab — STRATEGY head. Generated target: pine/efloud_lab_strategy.pine (scripts/build_pine_lab.py)
strategy("EFloud Lab Strategy", "EFloud Lab S", overlay = true, initial_capital = 1363, currency = currency.USD, commission_type = strategy.commission.percent, commission_value = 0.04, slippage = 1, pyramiding = 1, process_orders_on_close = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 1000)

// =============================================================================
// EFloud Pine Lab — CORE (single source: pine/lab/core.pine)
// Spec: docs/superpowers/specs/2026-11-05-pine-lab-design.md
// Baseline (all toggles OFF) = live SMC v2 entry logic (engine/smc_v2/luxalgo.py,
// LuxAlgo mode, profile mid). The structure engine ports the logic of
// "Smart Money Concepts (SMC) [LuxAlgo]" (CnB3fSph), © LuxAlgo, licensed
// CC BY-NC-SA 4.0 — https://creativecommons.org/licenses/by-nc-sa/4.0/
