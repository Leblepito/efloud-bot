//@version=6
// ═══════════════════════════════════════════════
// u2algo Wave-1 — SMC Strategy (P-001 / T-003)
// 15m trigger + 1h bias overlay
// v1.0.0-draft — T-003: Strategy + backtest
// ═══════════════════════════════════════════════
//
// © u2algo — Efloud SMC Core
// Pine Script v6, NO legacy study()
// STRATEGY version (premium, backtest + alert)
// INDICATOR version: pine/u2algo/wave1_signals.pine (free, lead magnet)
//
// ⚠️ SENKRON KURALI: Bu dosyadaki TÜM input isimleri indicator
//    (wave1_signals.pine) ile aynı olmak ZORUNDA. Aynı değişken adları,
//    aynı default değerler, aynı group'lar.

strategy(
 "u2algo SMC — Wave 1 Strategy",
 overlay=true,
 format=format.price,
 initial_capital=10000,
 default_qty_type=strategy.percent_of_equity,
 default_qty_value=10,  // YALNIZ fallback — fiili sizing risk_pct ile qty= üzerinden (F3)
 commission_type=strategy.commission.percent,
 commission_value=0.04,  // Binance futures taker 0.04%
 slippage=2,             // 2 tick slippage bütçesi (gerçekçi futures)
 pyramiding=1,
 max_labels_count=500,
 max_boxes_count=200,
 max_lines_count=200,
 calc_on_every_tick=false
)

// ═══════════════════════════════════════════════
// INPUTS — indicator ile SENKRON (§3d)
// ═══════════════════════════════════════════════

// Swing detection
swing_lb_label = "Swing Lookback (fixed at 4 per Plan §2a)"
swing_lb_left  = 4
swing_lb_right = 4

// Order Block
ob_seq_group   = "Order Block"
ob_seq_default = 5
ob_body_mult   = input.float(1.5, "OB Body/ATR Mult", minval=0.5, maxval=5.0, step=0.1,
 tooltip="Breakout body must exceed this × ATR(14)", group=ob_seq_group)

// Confluence & Risk
confluence_group = "Confluence & Risk"
conf_thresh = input.int(55, "Confluence Threshold", minval=0, maxval=100,
 tooltip="Minimum confluence score for signal validity (live-prod: 80)", group=confluence_group)
sl_lb     = input.int(20, "SL Lookback Bars", minval=5, maxval=50,
 tooltip="Number of bars to scan for structural SL level", group=confluence_group)
sl_atr_m  = input.float(0.5, "SL ATR Buffer", minval=0.1, maxval=2.0, step=0.1,
 tooltip="ATR(14) multiplier for SL buffer", group=confluence_group)
min_rr    = input.float(1.5, "Min R:R", minval=1.0, maxval=5.0, step=0.1,
 tooltip="Minimum (TP1−entry)/(entry−SL) ratio (live-prod: 1.8)", group=confluence_group)
fib_tp2   = input.float(1.618, "Fib TP2 Extension", minval=1.0, maxval=3.0, step=0.1,
 tooltip="Fibonacci extension from swing range for TP2 target", group=confluence_group)

// Visual
visual_group = "Visual"
show_sltp = input.bool(true, "Show SL/TP Levels",
 tooltip="Plot dashed SL/TP lines on chart", group=visual_group)
use_cb_palette = input.bool(false, "Colorblind-Friendly Palette",
 tooltip="Alternative palette for red/green color blindness", group=visual_group)

// Backtest
bt_group = "Backtest"
// round-5 defekt fix: eski default 2025-* → TV 15m 2026 verisinde in_window TÜM
// bar'ları dışlıyor (LATENT BUG: yayında 0 trade). Default artık "tüm yüklü veri".
bt_date_start = input.time(timestamp("2020-01-01"), "Start Date",
 tooltip="Backtest start (default = tüm veri; operatör OOS için daraltabilir)", group=bt_group)
bt_date_end   = input.time(timestamp("2035-01-01"), "End Date",
 tooltip="Backtest end (default = tüm veri)", group=bt_group)
bt_oos_pct    = input.int(30, "OOS %", minval=10, maxval=50,
 tooltip="% of data reserved for out-of-sample validation (bt_segment ile aktif)", group=bt_group)
// round-5 OOS-split: bt_segment entry'leri IS/OOS penceresine sınırlar (G-T4b ölçülebilir)
bt_segment    = input.string("Full", "Backtest Segment", options=["Full", "IS", "OOS"],
 tooltip="Full=tüm pencere; IS=ilk (100−oos%)%; OOS=son oos%. last_bar_index ile bölünür.", group=bt_group)

// Risk-based sizing (F3): %0.5 risk per trade, qty = (equity * risk_pct) / |entry - SL|
// MaxDD≤%5 gate'i risk_pct ile korunur (default 0.5%, max 2.0%)
risk_pct = input.float(0.5, "Risk % per trade", minval=0.1, maxval=2.0, step=0.1,
 tooltip="Risk per trade as % of equity. qty = (equity × risk%) / |entry − SL|. MaxDD≤%5 gate uyumu.", group=bt_group)

// T-003 R1 (Plan v1.4 §8a.2) — indicator ile SENKRON
r1_group = "T-003 R1 — Signal Loosening"
ob_active_window_bars = input.int(15, "OB Active Window (bars)",
 minval=1, maxval=50,
 tooltip="OB-aktif penceresi (eski: hardcoded 5). 3× daha uzun hafıza — indicator ile SENKRON.",
 group=r1_group)
// round-6: allow_ob_less KALDIRILDI — zone-pullback entry bir zone (OB|BB) gerektirir.

// T-003 R6: zone-pullback entry — fiyat zone'a (OB|BB near-edge) geri çekilince LİMİT fill.
pullback_timeout_bars = input.int(40, "Pullback Timeout (bars)", minval=10, maxval=100,
 tooltip="Fiyat zone'a pullback için kaç bar beklenir; dolmazsa iptal (engine pullback_timeout_bars).",
 group=r1_group)

// ═══════════════════════════════════════════════
// COLOR PALETTE — indicator ile aynı (§4)
// ═══════════════════════════════════════════════

col_long  = use_cb_palette ? color.new(#4488FF, 0) : color.new(#00FF88, 0)
col_short = use_cb_palette ? color.new(#FF8800, 0) : color.new(#FF4455, 0)
col_sl    = use_cb_palette ? color.new(#FF0000, 0) : color.new(#FF6644, 0)
col_tp1   = use_cb_palette ? color.new(#00CC44, 0) : color.new(#44DD88, 0)
col_tp2   = use_cb_palette ? color.new(#AA44FF, 0) : color.new(#4488FF, 0)
col_ob    = color.new(#FFDD44, 80)
col_swing = color.new(#CCCCCC, 0)
col_fvg   = color.new(#AA66FF, 40)
col_trend = color.new(#666666, 60)

// ═══════════════════════════════════════════════
// ATR (14-period)
// ═══════════════════════════════════════════════

atr14 = ta.atr(14)

// ═══════════════════════════════════════════════
// 1H BIAS — indicator ile aynı
// ═══════════════════════════════════════════════

htf_sym = syminfo.tickerid
htf_tf  = "60"

htf_close = request.security(htf_sym, htf_tf, close, lookahead=barmerge.lookahead_off)
htf_high  = request.security(htf_sym, htf_tf, high,  lookahead=barmerge.lookahead_off)
htf_low   = request.security(htf_sym, htf_tf, low,   lookahead=barmerge.lookahead_off)

htf_ema20      = ta.ema(htf_close, 20)
htf_bias_up    = htf_close > htf_ema20
htf_bias_down  = htf_close < htf_ema20

// ═══════════════════════════════════════════════
// SWING DETECTION — indicator ile aynı
// ═══════════════════════════════════════════════

lb = swing_lb_left

// --- Swing High ---
is_swing_high = false
swing_high_val = 0.0

if barstate.isconfirmed and bar_index >= lb * 2
    is_swing_high := true
    for j = 1 to lb
        if high[lb] <= high[lb - j] or high[lb] <= high[lb + j]
            is_swing_high := false
            break
    if is_swing_high
        swing_high_val := high[lb]

new_swing_high = is_swing_high

// --- Swing Low ---
is_swing_low = false
swing_low_val = 0.0

if barstate.isconfirmed and bar_index >= lb * 2
    is_swing_low := true
    for j = 1 to lb
        if low[lb] >= low[lb - j] or low[lb] >= low[lb + j]
            is_swing_low := false
            break
    if is_swing_low
        swing_low_val := low[lb]

new_swing_low = is_swing_low

// Persistent swing tracking
var float last_sh_price = na
var int   last_sh_bar   = na
var float last_sl_price = na
var int   last_sl_bar   = na

if barstate.isconfirmed
    if new_swing_high
        last_sh_price := swing_high_val
        last_sh_bar   := bar_index - lb
    if new_swing_low
        last_sl_price := swing_low_val
        last_sl_bar   := bar_index - lb

// ═══ EQH/EQL LIQUIDITY (engine smc.py:91-101,318-364 — Wave-1 pairwise) — round-6 ═══
var array<float> sh_arr = array.new<float>()
var array<float> sl_arr = array.new<float>()
int SW_CAP = 30
float eq_thr = 0.001
if barstate.isconfirmed and new_swing_high
    array.push(sh_arr, swing_high_val)
    if array.size(sh_arr) > SW_CAP
        array.shift(sh_arr)
if barstate.isconfirmed and new_swing_low
    array.push(sl_arr, swing_low_val)
    if array.size(sl_arr) > SW_CAP
        array.shift(sl_arr)

f_eq_levels(arr) =>
    res = array.new<float>()
    n = array.size(arr)
    if n >= 2
        for i = 0 to n - 2
            for j = i + 1 to n - 1
                a = array.get(arr, i)
                b = array.get(arr, j)
                if math.abs(a - b) / math.max(a, 1e-10) <= eq_thr
                    array.push(res, (a + b) / 2)
    res

// ═══════════════════════════════════════════════
// ORDER BLOCK DETECTION — indicator ile aynı
// ═══════════════════════════════════════════════

bar_bull  = close > open
bar_bear  = close < open
bar_body  = math.abs(close - open)
is_breakout_body = bar_body > ob_body_mult * atr14

// ═══ OB+BREAKER ZONE ARRAY (engine smc.py:200-256) — round-6 ═══
var array<float> ob_top = array.new<float>()
var array<float> ob_bot = array.new<float>()
var array<int>   ob_dir = array.new<int>()   // 1=demand(LONG), -1=supply(SHORT)
var array<int>   ob_bar = array.new<int>()
var array<bool>  ob_brk = array.new<bool>()
int OB_CAP = 30

// --- Bullish OB ---
bull_breakout = barstate.isconfirmed and bar_bull and is_breakout_body

// round-5: bullish_ob_top/bot/seq_count KALDIRILDI (entry artık close; bu vars'lar
// yalnızca eski limit-entry/box için yazılıyordu → unused-var marker temizliği).
var int   bullish_ob_bar       = na
var bool  bullish_ob_near_swing = false

if bull_breakout
    cnt = 0
    hi  = 0.0
    lo  = 1e10
    for k = 1 to ob_seq_default
        if bar_index - k >= 0 and close[k] < open[k]
            ct_i = open[k]
            cb_i = close[k]
            if cnt == 0
                hi := ct_i
                lo := cb_i
            else
                hi := math.max(hi, ct_i)
                lo := math.min(lo, cb_i)
            cnt += 1
        else if cnt > 0
            break
    if cnt == ob_seq_default and hi > lo
        ns = false
        if not na(last_sl_price)
            dist_pct_i = math.abs(lo - last_sl_price) / last_sl_price
            bars_since_sl_i = bar_index - last_sl_bar
            ns := dist_pct_i < 0.015 and bars_since_sl_i > 0 and bars_since_sl_i < 30
        bullish_ob_bar       := bar_index - cnt
        bullish_ob_near_swing := ns
        array.push(ob_top, hi)
        array.push(ob_bot, lo)
        array.push(ob_dir, 1)
        array.push(ob_bar, bar_index - cnt)
        array.push(ob_brk, false)
        if array.size(ob_top) > OB_CAP
            array.shift(ob_top)
            array.shift(ob_bot)
            array.shift(ob_dir)
            array.shift(ob_bar)
            array.shift(ob_brk)

// --- Bearish OB ---
bear_breakout = barstate.isconfirmed and bar_bear and is_breakout_body

// round-5: bearish_ob_top/bot/seq_count KALDIRILDI (entry artık close; unused-var temizliği).
var int   bearish_ob_bar       = na
var bool  bearish_ob_near_swing = false

if bear_breakout
    cnt = 0
    hi  = 0.0
    lo  = 1e10
    for k = 1 to ob_seq_default
        if bar_index - k >= 0 and close[k] > open[k]
            ct_i = close[k]
            cb_i = open[k]
            if cnt == 0
                hi := ct_i
                lo := cb_i
            else
                hi := math.max(hi, ct_i)
                lo := math.min(lo, cb_i)
            cnt += 1
        else if cnt > 0
            break
    if cnt == ob_seq_default and hi > lo
        ns = false
        if not na(last_sh_price)
            dist_pct_i = math.abs(hi - last_sh_price) / last_sh_price
            bars_since_sh_i = bar_index - last_sh_bar
            ns := dist_pct_i < 0.015 and bars_since_sh_i > 0 and bars_since_sh_i < 30
        bearish_ob_bar       := bar_index - cnt
        bearish_ob_near_swing := ns
        array.push(ob_top, hi)
        array.push(ob_bot, lo)
        array.push(ob_dir, -1)
        array.push(ob_bar, bar_index - cnt)
        array.push(ob_brk, false)
        if array.size(ob_top) > OB_CAP
            array.shift(ob_top)
            array.shift(ob_bot)
            array.shift(ob_dir)
            array.shift(ob_bar)
            array.shift(ob_brk)

// breaker flip: close OB içinden geçince yönü flip + breaker işaretle (round-6)
for i = 0 to array.size(ob_top) - 1
    if not array.get(ob_brk, i) and bar_index - array.get(ob_bar, i) >= 2
        d = array.get(ob_dir, i)
        if d == 1 and close < array.get(ob_bot, i)
            array.set(ob_dir, i, -1)
            array.set(ob_brk, i, true)
        else if d == -1 and close > array.get(ob_top, i)
            array.set(ob_dir, i, 1)
            array.set(ob_brk, i, true)

// ═══ FVG DETECTION (engine smc.py:38-44 portu) — round-6 ═══
// BULL FVG: low > high[2] (boşluk yukarı) · BEAR FVG: high < low[2] (boşluk aşağı)
var array<float> fvg_top = array.new<float>()
var array<float> fvg_bot = array.new<float>()
var array<int>   fvg_dir = array.new<int>()   // 1=BULL, -1=BEAR
var array<bool>  fvg_mit = array.new<bool>()
int FVG_CAP = 40
if barstate.isconfirmed
    if low > high[2]
        array.push(fvg_top, low)
        array.push(fvg_bot, high[2])
        array.push(fvg_dir, 1)
        array.push(fvg_mit, false)
    if high < low[2]
        array.push(fvg_top, low[2])
        array.push(fvg_bot, high)
        array.push(fvg_dir, -1)
        array.push(fvg_mit, false)
    while array.size(fvg_top) > FVG_CAP
        array.shift(fvg_top)
        array.shift(fvg_bot)
        array.shift(fvg_dir)
        array.shift(fvg_mit)
    for i = 0 to array.size(fvg_top) - 1
        if not array.get(fvg_mit, i) and low <= array.get(fvg_top, i) and high >= array.get(fvg_bot, i)
            array.set(fvg_mit, i, true)

// ═══════════════════════════════════════════════
// CONFLUENCE SCORING — indicator ile aynı
// ═══════════════════════════════════════════════
// Recent OB detection window (T-003 R1.a: 5 → ob_active_window_bars, indicator SENKRON)
bullish_ob_active = (bar_index - bullish_ob_bar) <= ob_active_window_bars and bullish_ob_bar > 0
bearish_ob_active = (bar_index - bearish_ob_bar) <= ob_active_window_bars and bearish_ob_bar > 0

htf_ema_slope = (htf_ema20 - htf_ema20[1]) / htf_ema20[1] * 100

// FVG
bullish_fvg = low > high[2]
bearish_fvg = high < low[2]

// Swing break
var float prev_swing_high = na
var float prev_swing_low  = na
if barstate.isconfirmed
    if new_swing_high
        prev_swing_high := swing_high_val
    if new_swing_low
        prev_swing_low := swing_low_val

recent_higher_high = not na(prev_swing_high) and high > prev_swing_high and (bar_index - last_sh_bar) < 50
recent_lower_low   = not na(prev_swing_low) and low < prev_swing_low and (bar_index - last_sl_bar) < 50

// Scores
confluence_score_long  = 0
confluence_score_long := bullish_ob_active ? confluence_score_long + 30 : confluence_score_long
confluence_score_long := bullish_ob_near_swing ? confluence_score_long + 15 : confluence_score_long
confluence_score_long := bull_breakout and bar_body > 2.0 * atr14 ? confluence_score_long + 10 : confluence_score_long
confluence_score_long := htf_bias_up ? confluence_score_long + 20 : confluence_score_long
confluence_score_long := htf_ema_slope > 0.1 ? confluence_score_long + 10 : confluence_score_long
confluence_score_long := bullish_fvg ? confluence_score_long + 5 : confluence_score_long
confluence_score_long := recent_higher_high ? confluence_score_long + 10 : confluence_score_long
confluence_score_long := math.min(100, confluence_score_long)

confluence_score_short  = 0
confluence_score_short := bearish_ob_active ? confluence_score_short + 30 : confluence_score_short
confluence_score_short := bearish_ob_near_swing ? confluence_score_short + 15 : confluence_score_short
confluence_score_short := bear_breakout and bar_body > 2.0 * atr14 ? confluence_score_short + 10 : confluence_score_short
confluence_score_short := htf_bias_down ? confluence_score_short + 20 : confluence_score_short
confluence_score_short := htf_ema_slope < -0.1 ? confluence_score_short + 10 : confluence_score_short
confluence_score_short := bearish_fvg ? confluence_score_short + 5 : confluence_score_short
confluence_score_short := recent_lower_low ? confluence_score_short + 10 : confluence_score_short
confluence_score_short := math.min(100, confluence_score_short)

// ═══════════════════════════════════════════════
// 1H SWING LEVELS — B1 repaint fix pattern
// ═══════════════════════════════════════════════

var float last_1h_swing_high = na
var float last_1h_swing_low  = na

if barstate.isconfirmed
    // ⚠️ REPAINT FIX: pivot adayı [3], komşular [3±j] — TÜM offset'ler ≥ 0
    is_1h_sh = true
    for j = 1 to 3
        if htf_high[3] <= htf_high[3 + j] or htf_high[3] <= htf_high[3 - j]
            is_1h_sh := false
            break
    if is_1h_sh
        last_1h_swing_high := htf_high[3]

    is_1h_sl = true
    for j = 1 to 3
        if htf_low[3] >= htf_low[3 + j] or htf_low[3] >= htf_low[3 - j]
            is_1h_sl := false
            break
    if is_1h_sl
        last_1h_swing_low := htf_low[3]

// ═══════════════════════════════════════════════
// SL HESAPLAMA — indicator ile aynı
// ═══════════════════════════════════════════════

f_calc_sl(direction, entry_price) =>
    low_min  = low
    high_max = high
    for i = 1 to sl_lb - 1
        if bar_index - i >= 0
            low_min  := math.min(low_min, low[i])
            high_max := math.max(high_max, high[i])

    atr_buf = sl_atr_m * atr14

    if direction == "LONG"
        structural = low_min - atr_buf
        stop_dist  = entry_price - structural
        min_dist   = math.max(0.5 * atr14, 0.001 * entry_price)  // SENKRON: indicator v1.1.1 N3 parite
        max_dist   = 5.0 * atr14
        if stop_dist < min_dist
            structural := entry_price - min_dist
        if stop_dist > max_dist
            structural := entry_price - max_dist
        structural
    else
        structural = high_max + atr_buf
        stop_dist  = structural - entry_price
        min_dist   = math.max(0.5 * atr14, 0.001 * entry_price)  // SENKRON: indicator v1.1.1 N3 parite
        max_dist   = 5.0 * atr14
        if stop_dist < min_dist
            structural := entry_price + min_dist
        if stop_dist > max_dist
            structural := entry_price + max_dist
        structural

// ═══════════════════════════════════════════════
// TP HESAPLAMA — round-6 engine-faithful (tp_calc.py:38-127)
// TP1 = en yakın {EQH/EQL likidite, HTF swing, FVG near} ≥ min_rr; yoksa RR-proj;
//       aday var ama yetersiz → tp1=na (REDDET). TP2 = FVG-far/fib (>TP1) / single-target.
// dönüş: [tp1, tp2, t1src, t2src]  (t1src: 0=LIQ,1=FVG_NEAR,2=RR_PROJ,-1=REJECT · t2src:0=FVG_FAR,1=FIB,2=NONE)
// ═══════════════════════════════════════════════

f_engine_tp(direction, entry, sl) =>
    risk = math.abs(entry - sl)
    min_dist = min_rr * risk
    cands = array.new<float>()
    csrc  = array.new<int>()
    eqh = f_eq_levels(sh_arr)
    eql = f_eq_levels(sl_arr)
    if direction == "LONG"
        if array.size(eqh) > 0
            for i = 0 to array.size(eqh) - 1
                if array.get(eqh, i) > entry
                    array.push(cands, array.get(eqh, i))
                    array.push(csrc, 0)
        if not na(last_1h_swing_high) and last_1h_swing_high > entry
            array.push(cands, last_1h_swing_high)
            array.push(csrc, 0)
        if array.size(fvg_top) > 0
            for i = 0 to array.size(fvg_top) - 1
                if not array.get(fvg_mit, i) and array.get(fvg_dir, i) == -1 and array.get(fvg_bot, i) > entry
                    array.push(cands, array.get(fvg_bot, i))
                    array.push(csrc, 1)
    else
        if array.size(eql) > 0
            for i = 0 to array.size(eql) - 1
                if array.get(eql, i) < entry
                    array.push(cands, array.get(eql, i))
                    array.push(csrc, 0)
        if not na(last_1h_swing_low) and last_1h_swing_low < entry
            array.push(cands, last_1h_swing_low)
            array.push(csrc, 0)
        if array.size(fvg_top) > 0
            for i = 0 to array.size(fvg_top) - 1
                if not array.get(fvg_mit, i) and array.get(fvg_dir, i) == 1 and array.get(fvg_top, i) < entry
                    array.push(cands, array.get(fvg_top, i))
                    array.push(csrc, 1)
    float tp1 = na
    int   t1src = 2
    float best = 1e20
    if array.size(cands) > 0
        for i = 0 to array.size(cands) - 1
            p = array.get(cands, i)
            dist = direction == "LONG" ? p - entry : entry - p
            if dist >= min_dist and dist < best
                best := dist
                tp1 := p
                t1src := array.get(csrc, i)
    float tp2 = na
    int   t2src = 2
    if na(tp1) and array.size(cands) > 0
        t1src := -1
    else
        if na(tp1)
            tp1 := direction == "LONG" ? entry + min_dist : entry - min_dist
            t1src := 2
        float ff = na
        if array.size(fvg_top) > 0
            for i = 0 to array.size(fvg_top) - 1
                if not array.get(fvg_mit, i)
                    if direction == "LONG" and array.get(fvg_dir, i) == -1 and array.get(fvg_top, i) > tp1
                        ff := na(ff) ? array.get(fvg_top, i) : math.min(ff, array.get(fvg_top, i))
                    if direction == "SHORT" and array.get(fvg_dir, i) == 1 and array.get(fvg_bot, i) < tp1
                        ff := na(ff) ? array.get(fvg_bot, i) : math.max(ff, array.get(fvg_bot, i))
        if not na(ff)
            tp2 := ff
            t2src := 0
        else
            fib = direction == "LONG" ? entry + fib_tp2 * risk : entry - fib_tp2 * risk
            if (direction == "LONG" and fib > tp1) or (direction == "SHORT" and fib < tp1)
                tp2 := fib
                t2src := 1
    [tp1, tp2, t1src, t2src]

// ═══ NEAREST ZONE (OB|BB near-edge, engine clamp karşılığı) — round-6 ═══
// want_dir: 1=LONG zone(demand) near-edge=top · -1=SHORT zone(supply) near-edge=bot
// round-6 FVG/OTE genişletme: entry zone evreni = OB|BB + FVG (engine primary) + OTE (fallback).
// LONG near-edge: zone üstü (yukarıdan ilk dokunuş) · SHORT near-edge: zone altı.
f_nearest_zone(want_dir) =>
    float best_edge = na
    float best_dist = 1e20
    // OB|BB zones
    if array.size(ob_top) > 0
        for i = 0 to array.size(ob_top) - 1
            if array.get(ob_dir, i) == want_dir
                edge = want_dir == 1 ? array.get(ob_top, i) : array.get(ob_bot, i)
                ok = want_dir == 1 ? (edge < close) : (edge > close)
                d = math.abs(close - edge)
                if ok and d < best_dist
                    best_dist := d
                    best_edge := edge
    // FVG zones (engine zones.py primary): LONG=BEAR FVG below (edge=top) · SHORT=BULL FVG above (edge=bot)
    if array.size(fvg_top) > 0
        for i = 0 to array.size(fvg_top) - 1
            if not array.get(fvg_mit, i)
                fdir = array.get(fvg_dir, i)
                if want_dir == 1 and fdir == -1
                    e = array.get(fvg_top, i)
                    if e < close and math.abs(close - e) < best_dist
                        best_dist := math.abs(close - e)
                        best_edge := e
                if want_dir == -1 and fdir == 1
                    e = array.get(fvg_bot, i)
                    if e > close and math.abs(close - e) < best_dist
                        best_dist := math.abs(close - e)
                        best_edge := e
    // OTE band (engine fallback): son swing leg'in 0.618 retracement near-edge'i
    if not na(last_sh_price) and not na(last_sl_price) and last_sh_price > last_sl_price
        dd = last_sh_price - last_sl_price
        ote_edge = want_dir == 1 ? last_sh_price - dd * 0.618 : last_sl_price + dd * 0.618
        ote_ok = want_dir == 1 ? (ote_edge < close) : (ote_edge > close)
        if ote_ok and math.abs(close - ote_edge) < best_dist
            best_dist := math.abs(close - ote_edge)
            best_edge := ote_edge
    best_edge

// ═══════════════════════════════════════════════
// T-003: STRATEGY EXECUTION
// ═══════════════════════════════════════════════

// round-5: market entry → entry fiyatı = sinyal barı close (OB seviyesi DEĞİL).
// OB confluence faktörü olarak KALIR (+30); f_entry_price kaldırıldı.

// Signal state (persistent across bars)
var float sig_entry_long  = na
var float sig_sl_long     = na
var float sig_tp1_long    = na
var float sig_tp2_long    = na
var bool  sig_active_long = false
var int   sig_entry_bar_long = 0   // round-6: pending limit pullback takibi (0=inaktif)

var float sig_entry_short = na
var float sig_sl_short    = na
var float sig_tp1_short   = na
var float sig_tp2_short   = na
var bool  sig_active_short = false
var int   sig_entry_bar_short = 0

// round-6 diagnostik: son entry'nin TP kaynak etiketleri (0=LIQ,1=FVG_NEAR,2=RR_PROJ / 0=FVG_FAR,1=FIB,2=NONE)
var int last_t1src = -9
var int last_t2src = -9
var int g_orders   = 0   // round-6 diagnostik: yerleştirilen limit emri sayısı (fill metriği)

is_in_trade = strategy.position_size != 0
long_signal  = false
short_signal = false

// round-6: sinyal = conf≥thresh + 1h bias + geçerli zone (OB|BB near-edge) + geçerli TP.
// pending limit varken (sig_entry_bar>0) yeni sinyal durur; entry zone'a pullback LİMİT'i.
if barstate.isconfirmed and not is_in_trade and sig_entry_bar_long == 0 and sig_entry_bar_short == 0
    // --- LONG ---
    if htf_bias_up and (recent_higher_high or confluence_score_long >= conf_thresh)
        ln_entry = f_nearest_zone(1)
        if not na(ln_entry)
            ln_sl = f_calc_sl("LONG", ln_entry)
            [ln_tp1, ln_tp2, ln_t1s, ln_t2s] = f_engine_tp("LONG", ln_entry, ln_sl)
            valid = not na(ln_sl) and not na(ln_tp1) and ln_sl < ln_entry and ln_tp1 > ln_entry
            if valid
                long_signal := true
                sig_entry_long  := ln_entry
                sig_sl_long     := ln_sl
                sig_tp1_long    := ln_tp1
                sig_tp2_long    := ln_tp2
                sig_active_long := true
                sig_entry_bar_long := bar_index
                last_t1src := ln_t1s
                last_t2src := ln_t2s

    // --- SHORT ---
    if htf_bias_down and (recent_lower_low or confluence_score_short >= conf_thresh)
        sh_entry = f_nearest_zone(-1)
        if not na(sh_entry)
            sh_sl = f_calc_sl("SHORT", sh_entry)
            [sh_tp1, sh_tp2, sh_t1s, sh_t2s] = f_engine_tp("SHORT", sh_entry, sh_sl)
            valid = not na(sh_sl) and not na(sh_tp1) and sh_sl > sh_entry and sh_tp1 < sh_entry
            if valid
                short_signal := true
                sig_entry_short := sh_entry
                sig_sl_short    := sh_sl
                sig_tp1_short   := sh_tp1
                sig_tp2_short   := sh_tp2
                sig_active_short := true
                sig_entry_bar_short := bar_index
                last_t1src := sh_t1s
                last_t2src := sh_t2s

// ═══════════════════════════════════════════════
// STRATEGY ENTRY + EXIT (round-6: near-edge zone-pullback LİMİT + timeout)
// ═══════════════════════════════════════════════
oos_start_idx = last_bar_index - int(last_bar_index * bt_oos_pct / 100)
seg_ok = bt_segment == "Full" ? true : bt_segment == "OOS" ? (bar_index >= oos_start_idx) : (bar_index < oos_start_idx)

// LONG — LİMİT @ near edge (zone üstü); fiyat pullback edince fill
if sig_active_long and not na(sig_entry_long) and not na(sig_sl_long) and not na(sig_tp1_long)
    in_window = (time >= bt_date_start) and (time <= bt_date_end)
    if in_window and seg_ok
        risk_per_unit = math.abs(sig_entry_long - sig_sl_long)
        float risk_qty = risk_per_unit > 0 ? (strategy.equity * risk_pct / 100) / risk_per_unit : na
        strategy.entry("LONG", strategy.long, limit=sig_entry_long, qty=risk_qty)
        g_orders += 1
        if na(sig_tp2_long)
            strategy.exit("XL", "LONG", stop=sig_sl_long, limit=sig_tp1_long, comment="TP1")
        else
            strategy.exit("XL", "LONG", stop=sig_sl_long, limit=sig_tp1_long, qty_percent=50, comment="TP1")
            strategy.exit("XT2", "LONG", stop=sig_sl_long, limit=sig_tp2_long, comment="TP2")
    sig_active_long := false

// SHORT — LİMİT @ near edge (zone altı)
if sig_active_short and not na(sig_entry_short) and not na(sig_sl_short) and not na(sig_tp1_short)
    in_window = (time >= bt_date_start) and (time <= bt_date_end)
    if in_window and seg_ok
        risk_per_unit = math.abs(sig_entry_short - sig_sl_short)
        float risk_qty = risk_per_unit > 0 ? (strategy.equity * risk_pct / 100) / risk_per_unit : na
        strategy.entry("SHORT", strategy.short, limit=sig_entry_short, qty=risk_qty)
        g_orders += 1
        if na(sig_tp2_short)
            strategy.exit("XS", "SHORT", stop=sig_sl_short, limit=sig_tp1_short, comment="TP1")
        else
            strategy.exit("XS", "SHORT", stop=sig_sl_short, limit=sig_tp1_short, qty_percent=50, comment="TP1")
            strategy.exit("XT2S", "SHORT", stop=sig_sl_short, limit=sig_tp2_short, comment="TP2")
    sig_active_short := false

// round-6 pullback timeout + fill reset (round-4 mantığı):
// fill olunca (is_in_trade) her iki yöne cancel + sayaç reset; timeout aşılınca cancel.
if is_in_trade and (sig_entry_bar_long > 0 or sig_entry_bar_short > 0)
    strategy.cancel("LONG")
    strategy.cancel("SHORT")
    sig_entry_bar_long  := 0
    sig_entry_bar_short := 0
if sig_entry_bar_long > 0 and not is_in_trade and (bar_index - sig_entry_bar_long) > pullback_timeout_bars
    strategy.cancel("LONG")
    sig_entry_bar_long := 0
if sig_entry_bar_short > 0 and not is_in_trade and (bar_index - sig_entry_bar_short) > pullback_timeout_bars
    strategy.cancel("SHORT")
    sig_entry_bar_short := 0

// ═══════════════════════════════════════════════
// VISUAL — SL/TP plot + OB boxes (indicator ile aynı)
// ═══════════════════════════════════════════════

// (G-T3 ön-fix: line.new pozisyonel 5./6./7. argümanlar xloc/extend/color'a
//  düşüyor — named arg zorunlu: color=/width=/style=)
if show_sltp and not na(sig_entry_long)
    line.new(bar_index, sig_sl_long,  bar_index + 20, sig_sl_long,  color=col_sl,  width=2, style=line.style_dashed)
    line.new(bar_index, sig_tp1_long, bar_index + 20, sig_tp1_long, color=col_tp1, width=1, style=line.style_dashed)
    if not na(sig_tp2_long) and sig_tp2_long > sig_tp1_long
        line.new(bar_index, sig_tp2_long, bar_index + 20, sig_tp2_long, color=col_tp2, width=1, style=line.style_dashed)
    label.new(bar_index, sig_entry_long,
     "LONG " + str.tostring(confluence_score_long, "0") + "%",
     style=label.style_label_up,
     color=color.new(col_long, 90), textcolor=col_long, size=size.small)

if show_sltp and not na(sig_entry_short)
    line.new(bar_index, sig_sl_short,  bar_index + 20, sig_sl_short,  color=col_sl,  width=2, style=line.style_dashed)
    line.new(bar_index, sig_tp1_short, bar_index + 20, sig_tp1_short, color=col_tp1, width=1, style=line.style_dashed)
    if not na(sig_tp2_short) and sig_tp2_short < sig_tp1_short
        line.new(bar_index, sig_tp2_short, bar_index + 20, sig_tp2_short, color=col_tp2, width=1, style=line.style_dashed)
    label.new(bar_index, sig_entry_short,
     "SHORT " + str.tostring(confluence_score_short, "0") + "%",
     style=label.style_label_down,
     color=color.new(col_short, 90), textcolor=col_short, size=size.small)

// ═══════════════════════════════════════════════
// SWING LABELS + BIAS TABLE (indicator ile aynı)
// ═══════════════════════════════════════════════

if barstate.isconfirmed and new_swing_high
    label.new(bar_index - lb, swing_high_val,
     "HH", style=label.style_label_down,
     color=color.new(col_swing, 90), textcolor=col_swing, size=size.small)

if barstate.isconfirmed and new_swing_low
    label.new(bar_index - lb, swing_low_val,
     "LL", style=label.style_label_up,
     color=color.new(col_swing, 90), textcolor=col_swing, size=size.small)

plot_htf = request.security(htf_sym, htf_tf,
 ta.ema(close, 20), lookahead=barmerge.lookahead_off)
plot(plot_htf, "1H EMA20", col_trend, 2, plot.style_line)

var table bias_table = table.new(position.top_right, 1, 1,
 border_width=0, frame_width=0)

if barstate.islastconfirmedhistory
    h1_text = htf_bias_up ? "▲ 1H BULL" : htf_bias_down ? "▼ 1H BEAR" : "— 1H FLAT"
    h1_color = htf_bias_up ? col_long : htf_bias_down ? col_short : col_trend
    table.cell(bias_table, 0, 0, h1_text, text_color=h1_color, text_size=size.small)
    table.cell_set_bgcolor(bias_table, 0, 0, color.new(#000000, 80))

// ═══ ROUND-6 DIAGNOSTIC TABLE (Faz-0 ölçüm; Faz-1'de sökülür) ═══
if barstate.islastconfirmedhistory
    n = strategy.closedtrades
    msum = 0.0
    for i = 0 to (n > 0 ? n - 1 : 0)
        if i < n
            msum += strategy.closedtrades.profit(i)
    mean = n > 0 ? msum / n : 0.0
    ssq = 0.0
    for i = 0 to (n > 0 ? n - 1 : 0)
        if i < n
            d = strategy.closedtrades.profit(i) - mean
            ssq += d * d
    sd = n > 1 ? math.sqrt(ssq / (n - 1)) : 0.0
    sharpe = sd > 0 ? mean / sd : 0.0
    pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : 0.0
    winp = n > 0 ? strategy.wintrades / n * 100 : 0.0
    netp = strategy.netprofit / strategy.initial_capital * 100
    ddp = strategy.max_drawdown / strategy.initial_capital * 100
    var table gt = table.new(position.middle_right, 2, 12, border_width=1, frame_color=color.gray, bgcolor=color.new(color.black, 0))
    table.cell(gt, 0, 0, "R6", text_color=color.yellow)
    table.cell(gt, 1, 0, syminfo.ticker + "/" + bt_segment, text_color=color.yellow)
    table.cell(gt, 0, 1, "closedlegs", text_color=color.white)
    table.cell(gt, 1, 1, str.tostring(n), text_color=color.white)
    table.cell(gt, 0, 2, "orders", text_color=color.white)
    table.cell(gt, 1, 2, str.tostring(g_orders), text_color=color.white)
    table.cell(gt, 0, 3, "win%", text_color=color.white)
    table.cell(gt, 1, 3, str.tostring(winp, "0.0"), text_color=color.white)
    table.cell(gt, 0, 4, "PF", text_color=color.aqua)
    table.cell(gt, 1, 4, str.tostring(pf, "0.00"), text_color=color.aqua)
    table.cell(gt, 0, 5, "net%", text_color=color.white)
    table.cell(gt, 1, 5, str.tostring(netp, "0.0"), text_color=color.white)
    table.cell(gt, 0, 6, "maxDD%", text_color=color.white)
    table.cell(gt, 1, 6, str.tostring(ddp, "0.0"), text_color=color.white)
    table.cell(gt, 0, 7, "sharpe", text_color=color.white)
    table.cell(gt, 1, 7, str.tostring(sharpe, "0.000"), text_color=color.white)
    table.cell(gt, 0, 8, "gprofit", text_color=color.white)
    table.cell(gt, 1, 8, str.tostring(strategy.grossprofit, "0"), text_color=color.white)
    table.cell(gt, 0, 9, "gloss", text_color=color.white)
    table.cell(gt, 1, 9, str.tostring(strategy.grossloss, "0"), text_color=color.white)
    table.cell(gt, 0, 10, "t1src", text_color=color.white)
    table.cell(gt, 1, 10, str.tostring(last_t1src), text_color=color.white)
    table.cell(gt, 0, 11, "t2src", text_color=color.white)
    table.cell(gt, 1, 11, str.tostring(last_t2src), text_color=color.white)

// ═══════════════════════════════════════════════
// ALERTS — strategy'de alertcondition() etkisizdir (derleyici warning'i);
// dinamik alert() kullanılır. Sinyaller confirmed-bar'da üretildiği için
// freq_once_per_bar_close ile repaint'siz tetikleme.
//
// Mesaj formatı (Telegram/Discord webhook consumer tarafından parse edilebilir):
//   SYMBOL  DIRECTION  ENTRY=price  SL=price  TP1=price  TP2=price
//   CONF=n%  RISK_PCT=n%  TF=15m+1h
// Örnek: "BTCUSDT-PERP  LONG  ENTRY=67500.5  SL=67200.0  TP1=68100.0
//         TP2=68800.0  CONF=78%  RISK_PCT=0.5%  TF=15m+1h"
// ═══════════════════════════════════════════════

// Sym: Pine default ticker (örn. "BTCUSDT" / "BINANCE:BTCUSDT")
sym = syminfo.ticker

if long_signal and not na(sig_entry_long) and not na(sig_sl_long) and not na(sig_tp1_long)
    msg = sym + "  LONG  ENTRY=" + str.tostring(sig_entry_long, "#.##") +
     "  SL=" + str.tostring(sig_sl_long, "#.##") +
     "  TP1=" + str.tostring(sig_tp1_long, "#.##")
    if not na(sig_tp2_long)
        msg := msg + "  TP2=" + str.tostring(sig_tp2_long, "#.##")
    msg := msg + "  CONF=" + str.tostring(confluence_score_long, "0") + "%" +
     "  RISK_PCT=" + str.tostring(risk_pct, "#.#") + "%" +
     "  TF=15m+1h"
    alert(msg, alert.freq_once_per_bar_close)

if short_signal and not na(sig_entry_short) and not na(sig_sl_short) and not na(sig_tp1_short)
    msg = sym + "  SHORT  ENTRY=" + str.tostring(sig_entry_short, "#.##") +
     "  SL=" + str.tostring(sig_sl_short, "#.##") +
     "  TP1=" + str.tostring(sig_tp1_short, "#.##")
    if not na(sig_tp2_short)
        msg := msg + "  TP2=" + str.tostring(sig_tp2_short, "#.##")
    msg := msg + "  CONF=" + str.tostring(confluence_score_short, "0") + "%" +
     "  RISK_PCT=" + str.tostring(risk_pct, "#.#") + "%" +
     "  TF=15m+1h"
    alert(msg, alert.freq_once_per_bar_close)
