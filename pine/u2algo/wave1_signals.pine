//@version=6
// ═══════════════════════════════════════════════
// u2algo Wave-1 — SMC Indicator (P-001 / T-001)
// 15m trigger + 1h bias overlay
// v1.1.0 — T-002: MTF confluence + SL/TP hesaplama
// ═══════════════════════════════════════════════
//
// © u2algo — Efloud SMC Core
// Pine Script v6, NO legacy study()/ema()
// INDICATOR (free, lead magnet)
// STRATEGY version: pine/u2algo/wave1_strategy.pine (premium, T-003)
//
// NOT: pine/efloud_signals.pine (SMC v2 sadık port, compile-verified
// 2026-05-30, PR #148 TV publish temeli) AYRI bir üründür — bu dosya
// onu DEĞİŞTİRMEZ. Wave-1 = u2algo pazarlama indikatörü (daraltılmış kapsam).

indicator(
 "u2algo SMC — Wave 1",
 overlay=true,
 format=format.price,
 max_labels_count=500,
 max_boxes_count=200,
 max_lines_count=200
)

// ═══════════════════════════════════════════════
// INPUTS — Plan §3d parameter mapping
// ═══════════════════════════════════════════════

// Swing detection — hardcoded lookback=4 per Plan §2a
// NOTE: ta.pivothigh/pivotlow require simple int; input.int is series int.
// We embed the lookback values directly and expose a group label for docs.
swing_lb_label = "Swing Lookback (fixed at 4 per Plan §2a)"
swing_lb_left  = 4
swing_lb_right = 4

// Order Block
ob_seq_group   = "Order Block"
ob_seq_default = 5
ob_body_mult   = input.float(1.5, "OB Body/ATR Mult", minval=0.5, maxval=5.0, step=0.1,
 tooltip="Breakout body must exceed this × ATR(14)", group=ob_seq_group)

// T-001: conf_thresh (T-002'de kullanılacak)
confluence_group = "Confluence & Risk"
conf_thresh = input.int(55, "Confluence Threshold", minval=0, maxval=100,
 tooltip="Minimum confluence score for signal validity (live-prod: 80)", group=confluence_group)

// T-002: SL/TP inputs
sl_lb     = input.int(20, "SL Lookback Bars", minval=5, maxval=50,
 tooltip="Number of bars to scan for structural SL level", group=confluence_group)
sl_atr_m  = input.float(0.5, "SL ATR Buffer", minval=0.1, maxval=2.0, step=0.1,
 tooltip="ATR(14) multiplier for SL buffer", group=confluence_group)
min_rr    = input.float(1.5, "Min R:R", minval=1.0, maxval=5.0, step=0.1,
 tooltip="Minimum (TP1−entry)/(entry−SL) ratio (live-prod: 1.8)", group=confluence_group)
fib_tp2   = input.float(1.618, "Fib TP2 Extension", minval=1.0, maxval=3.0, step=0.1,
 tooltip="Fibonacci extension from swing range for TP2 target", group=confluence_group)
show_sltp = input.bool(true, "Show SL/TP Levels",
 tooltip="Plot dashed SL/TP lines on chart", group=visual_group)

// Visual
visual_group = "Visual"
use_cb_palette = input.bool(false, "Colorblind-Friendly Palette",
 tooltip="Alternative palette for red/green color blindness", group=visual_group)

// ═══════════════════════════════════════════════
// COLOR PALETTE — Plan §4
// ═══════════════════════════════════════════════

// Dark theme (default)
col_long  = use_cb_palette ? color.new(#4488FF, 0) : color.new(#00FF88, 0)
col_short = use_cb_palette ? color.new(#FF8800, 0) : color.new(#FF4455, 0)
col_sl    = use_cb_palette ? color.new(#FF0000, 0) : color.new(#FF6644, 0)
col_tp1   = use_cb_palette ? color.new(#00CC44, 0) : color.new(#44DD88, 0)
col_tp2   = use_cb_palette ? color.new(#AA44FF, 0) : color.new(#4488FF, 0)
col_ob    = color.new(#FFDD44, 80)
col_swing = color.new(#CCCCCC, 0)
col_fvg   = color.new(#AA66FF, 40)
col_trend = color.new(#666666, 60)

// ═══════════════════════════════════════════════
// ATR (14-period, for OB body check)
// ═══════════════════════════════════════════════

atr14  = ta.atr(14)

// ═══════════════════════════════════════════════
// 1H BIAS — Higher-Timeframe Trend via request.security()
// ═══════════════════════════════════════════════

// Use lookahead_off to prevent repaint from higher TF
htf_sym = syminfo.tickerid
htf_tf  = "60"  // 1 hour

// Get 1h close (confirmed bars only). OHLC'nin kalanı T-002'de (CHoCH/BOS)
// gerektiğinde eklenir — kullanılmayan request.security çağrısı tutulmaz.
htf_close = request.security(htf_sym, htf_tf, close, lookahead=barmerge.lookahead_off)

// Simple 1h bias: 20-bar EMA slope as directional bias
htf_ema20      = ta.ema(htf_close, 20)
htf_bias_up    = htf_close > htf_ema20
htf_bias_down  = htf_close < htf_ema20

// ═══════════════════════════════════════════════
// SWING DETECTION — Plan §2a, Python swings() method
// ═══════════════════════════════════════════════
//
// Python: for i in range(lb, n-lb):
//   if all(h[i] > h[i-j] and h[i] > h[i+j] for j in range(1, lb+1)):
//     → swing HIGH
//   if all(l[i] < l[i-j] and l[i] < l[i+j] for j in range(1, lb+1)):
//     → swing LOW
//
// In Pine: manual check using history reference operator [N]
// lb=4 → check 4 bars left AND 4 bars right.
// Only evaluate on barstate.isconfirmed to avoid repaint.

lb = swing_lb_left  // 4

// --- Swing High ---
is_swing_high = false
swing_high_val = 0.0

if barstate.isconfirmed and bar_index >= lb * 2
    is_swing_high := true
    for j = 1 to lb
        if high[lb] <= high[lb - j] or high[lb] <= high[lb + j]
            is_swing_high := false
            break
    if is_swing_high
        swing_high_val := high[lb]

new_swing_high = is_swing_high

// --- Swing Low ---
is_swing_low = false
swing_low_val = 0.0

if barstate.isconfirmed and bar_index >= lb * 2
    is_swing_low := true
    for j = 1 to lb
        if low[lb] >= low[lb - j] or low[lb] >= low[lb + j]
            is_swing_low := false
            break
    if is_swing_low
        swing_low_val := low[lb]

new_swing_low = is_swing_low

// Store most recent swing high/low prices and bar indices for OB proximity check
var float last_sh_price = na
var int   last_sh_bar   = na
var float last_sl_price = na
var int   last_sl_bar   = na

// Only update when confirmed
if barstate.isconfirmed
    if new_swing_high
        last_sh_price := swing_high_val
        last_sh_bar   := bar_index - lb
    if new_swing_low
        last_sl_price := swing_low_val
        last_sl_bar   := bar_index - lb

// ═══════════════════════════════════════════════
// ORDER BLOCK DETECTION — Plan §2a, Python order_blocks() method
// ═══════════════════════════════════════════════

// Bar classification
bar_bull  = close > open
bar_bear  = close < open
bar_body  = math.abs(close - open)

// Breakout condition: body > ob_body_mult × ATR(14)
is_breakout_body = bar_body > ob_body_mult * atr14

// --- Bullish OB ---
// Current bar: BULLISH BREAKOUT (close > open, body > threshold)
// Previous ob_seq bars: BEARISH (close < open), consecutive
bull_breakout = barstate.isconfirmed and bar_bull and is_breakout_body

var int   bullish_ob_seq_count = 0
var float bullish_ob_top       = na
var float bullish_ob_bot       = na
var int   bullish_ob_bar       = na
var bool  bullish_ob_near_swing = false  // T-002: confluence skorlamasında kullanılır

if bull_breakout
    cnt = 0
    hi  = 0.0
    lo  = 1e10
    for k = 1 to ob_seq_default
        if bar_index - k >= 0 and close[k] < open[k]
            ct_i = open[k]
            cb_i = close[k]
            if cnt == 0
                hi := ct_i
                lo := cb_i
            else
                hi := math.max(hi, ct_i)
                lo := math.min(lo, cb_i)
            cnt += 1
        else if cnt > 0
            break
    // Plan §2a fidelity: OB = TAM ob_seq (5) ardışık ters yönlü mum gerektirir
    if cnt == ob_seq_default and hi > lo
        // Check near swing proximity (within ~30 bars, 1.5% price)
        ns = false
        if not na(last_sl_price)
            dist_pct_i = math.abs(lo - last_sl_price) / last_sl_price
            bars_since_sl_i = bar_index - last_sl_bar
            ns := dist_pct_i < 0.015 and bars_since_sl_i > 0 and bars_since_sl_i < 30
        bullish_ob_seq_count := cnt
        bullish_ob_top       := hi
        bullish_ob_bot       := lo
        bullish_ob_bar       := bar_index - cnt
        bullish_ob_near_swing := ns
        // Draw OB box
        box.new(
         bullish_ob_bar, bullish_ob_top,
         bar_index,       bullish_ob_bot,
         col_ob, 1, line.style_solid,
         bgcolor=col_ob
        )

// --- Bearish OB ---
// Current bar: BEARISH BREAKOUT (close < open, body > threshold)
// Previous ob_seq bars: BULLISH (close > open), consecutive
bear_breakout = barstate.isconfirmed and bar_bear and is_breakout_body

var int   bearish_ob_seq_count = 0
var float bearish_ob_top       = na
var float bearish_ob_bot       = na
var int   bearish_ob_bar       = na
var bool  bearish_ob_near_swing = false  // T-002: confluence skorlamasında kullanılır

if bear_breakout
    cnt = 0
    hi  = 0.0
    lo  = 1e10
    for k = 1 to ob_seq_default
        if bar_index - k >= 0 and close[k] > open[k]
            ct_i = close[k]
            cb_i = open[k]
            if cnt == 0
                hi := ct_i
                lo := cb_i
            else
                hi := math.max(hi, ct_i)
                lo := math.min(lo, cb_i)
            cnt += 1
        else if cnt > 0
            break
    // Plan §2a fidelity: OB = TAM ob_seq (5) ardışık ters yönlü mum gerektirir
    if cnt == ob_seq_default and hi > lo
        ns = false
        if not na(last_sh_price)
            dist_pct_i = math.abs(hi - last_sh_price) / last_sh_price
            bars_since_sh_i = bar_index - last_sh_bar
            ns := dist_pct_i < 0.015 and bars_since_sh_i > 0 and bars_since_sh_i < 30
        bearish_ob_seq_count := cnt
        bearish_ob_top       := hi
        bearish_ob_bot       := lo
        bearish_ob_bar       := bar_index - cnt
        bearish_ob_near_swing := ns
        box.new(
         bearish_ob_bar, bearish_ob_top,
         bar_index,       bearish_ob_bot,
         col_ob, 1, line.style_solid,
         bgcolor=col_ob
        )

// ═══════════════════════════════════════════════
// T-002: CONFLUENCE SCORING — Plan §2a (min threshold: 55, live-prod: 80)
// ═══════════════════════════════════════════════
//
// Scoring model:
//   +30   OB detected (bullish or bearish body breakout)
//   +15   OB near swing (±1.5% price, <30 bars)
//   +10   Strong breakout (body > 2.0×ATR)
//   +20   1h bias aligned with signal direction
//   +10   Trend strength (1h EMA slope > 0.1%/bar)
//   +5    FVG (gap between consecutive bars)
//   +10   Recent swing break (higher high / lower low)
//   ──────
//   max 100
// ═══════════════════════════════════════════════

// --- Recent OB detection window (last 5 bars) ---
bullish_ob_active  = (bar_index - bullish_ob_bar) <= 5 and bullish_ob_bar > 0
bearish_ob_active  = (bar_index - bearish_ob_bar) <= 5 and bearish_ob_bar > 0

// --- 1h EMA slope (trend strength, % per bar) ---
htf_ema_slope = (htf_ema20 - htf_ema20[1]) / htf_ema20[1] * 100

// --- FVG (Fair Value Gap) detection ---
// Bullish FVG: current low > previous 2nd high → gap up
bullish_fvg = low > high[2]
bearish_fvg = high < low[2]
fvg_active  = bullish_fvg or bearish_fvg

// --- Recent swing break (higher high / lower low) ---
var float prev_swing_high = na
var float prev_swing_low  = na
if barstate.isconfirmed
    if new_swing_high
        prev_swing_high := swing_high_val
    if new_swing_low
        prev_swing_low := swing_low_val

recent_higher_high = not na(prev_swing_high) and high > prev_swing_high and\
                      (bar_index - last_sh_bar) < 50
recent_lower_low   = not na(prev_swing_low) and low < prev_swing_low and\
                      (bar_index - last_sl_bar) < 50
swing_break_active = recent_higher_high or recent_lower_low

// --- Score accumulation ---
confluence_score_long  = 0
confluence_score_long := bullish_ob_active ? confluence_score_long + 30 : confluence_score_long
confluence_score_long := bullish_ob_near_swing ? confluence_score_long + 15 : confluence_score_long
confluence_score_long := bull_breakout and bar_body > 2.0 * atr14 ? confluence_score_long + 10 : confluence_score_long
confluence_score_long := htf_bias_up ? confluence_score_long + 20 : confluence_score_long
confluence_score_long := htf_ema_slope > 0.1 ? confluence_score_long + 10 : confluence_score_long
confluence_score_long := bullish_fvg ? confluence_score_long + 5 : confluence_score_long
confluence_score_long := recent_higher_high ? confluence_score_long + 10 : confluence_score_long
confluence_score_long := math.min(100, confluence_score_long)

confluence_score_short  = 0
confluence_score_short := bearish_ob_active ? confluence_score_short + 30 : confluence_score_short
confluence_score_short := bearish_ob_near_swing ? confluence_score_short + 15 : confluence_score_short
confluence_score_short := bear_breakout and bar_body > 2.0 * atr14 ? confluence_score_short + 10 : confluence_score_short
confluence_score_short := htf_bias_down ? confluence_score_short + 20 : confluence_score_short
confluence_score_short := htf_ema_slope < -0.1 ? confluence_score_short + 10 : confluence_score_short
confluence_score_short := bearish_fvg ? confluence_score_short + 5 : confluence_score_short
confluence_score_short := recent_lower_low ? confluence_score_short + 10 : confluence_score_short
confluence_score_short := math.min(100, confluence_score_short)

// ═══════════════════════════════════════════════
// T-002: 1H SWING LEVELS — TP1 hedefi için HTF likidite
// ═══════════════════════════════════════════════

// Request 1h high/low for swing level detection
htf_high = request.security(htf_sym, htf_tf, high, lookahead=barmerge.lookahead_off)
htf_low  = request.security(htf_sym, htf_tf, low,  lookahead=barmerge.lookahead_off)

// Detect 1h swing levels (pivot-based, lookback=3 since 1h has fewer bars)
var float last_1h_swing_high = na
var float last_1h_swing_low  = na
var int   last_1h_swing_high_bar = na
var int   last_1h_swing_low_bar  = na

if barstate.isconfirmed
    // 1h swing high: current 1h high > previous 3 and next 3
    is_1h_sh = true
    for j = 1 to 3
        if htf_high <= htf_high[j] or htf_high <= htf_high[-j]
            is_1h_sh := false
            break
    if is_1h_sh
        last_1h_swing_high := htf_high
        last_1h_swing_high_bar := bar_index
    
    // 1h swing low
    is_1h_sl = true
    for j = 1 to 3
        if htf_low >= htf_low[j] or htf_low >= htf_low[-j]
            is_1h_sl := false
            break
    if is_1h_sl
        last_1h_swing_low := htf_low
        last_1h_swing_low_bar := bar_index

// ═══════════════════════════════════════════════
// T-002: SL HESAPLAMA — Plan §2a
//   LONG:  min(low[sl_lb]) − sl_atr_m×ATR(14)
//   SHORT: max(high[sl_lb]) + sl_atr_m×ATR(14)
//   Clamp: min 0.5×ATR(14), max 5.0×ATR(14)
// ═══════════════════════════════════════════════

f_calc_sl(direction, entry_price) =>
    var low_min  = 0.0
    var high_max = 0.0
    // Scan last sl_lb bars for extremes
    low_min  := low
    high_max := high
    for i = 1 to sl_lb - 1
        if bar_index - i >= 0
            low_min  := math.min(low_min, low[i])
            high_max := math.max(high_max, high[i])
    
    atr_buf = sl_atr_m * atr14
    
    if direction == "LONG"
        structural = low_min - atr_buf
        stop_dist  = entry_price - structural
        min_dist   = 0.5 * atr14
        max_dist   = 5.0 * atr14
        // Clamp
        if stop_dist < min_dist
            structural := entry_price - min_dist
        if stop_dist > max_dist
            structural := entry_price - max_dist
        structural
    else  // SHORT
        structural = high_max + atr_buf
        stop_dist  = structural - entry_price
        min_dist   = 0.5 * atr14
        max_dist   = 5.0 * atr14
        if stop_dist < min_dist
            structural := entry_price + min_dist
        if stop_dist > max_dist
            structural := entry_price + max_dist
        structural

// ═══════════════════════════════════════════════
// T-002: TP HESAPLAMA — Plan §2a
//   TP1: nearest 1h swing liquidity (above entry for LONG, below for SHORT)
//   TP2: Fibonacci extension from recent swing range
// ═══════════════════════════════════════════════

f_calc_tp(direction, entry_price, sl_price) =>
    tp1 = na
    tp2 = na
    
    // TP1: nearest 1h swing level
    if direction == "LONG"
        if not na(last_1h_swing_high) and last_1h_swing_high > entry_price
            tp1 := last_1h_swing_high
        else if not na(prev_swing_high)
            tp1 := prev_swing_high
        // Fallback: min RR from SL
        if na(tp1) or tp1 <= entry_price or (tp1 - entry_price) / (entry_price - sl_price) < min_rr
            tp1 := entry_price + (entry_price - sl_price) * min_rr
        
        // TP2: Fibonacci extension from swing range
        if not na(prev_swing_low) and not na(prev_swing_high)
            swing_range = prev_swing_high - prev_swing_low
            tp2 := entry_price + swing_range * fib_tp2
        // Fallback
        if na(tp2) or tp2 < tp1
            tp2 := tp1 * 1.02  // minimal extension
    else  // SHORT
        if not na(last_1h_swing_low) and last_1h_swing_low < entry_price
            tp1 := last_1h_swing_low
        else if not na(prev_swing_low)
            tp1 := prev_swing_low
        if na(tp1) or tp1 >= entry_price or (entry_price - tp1) / (sl_price - entry_price) < min_rr
            tp1 := entry_price - (sl_price - entry_price) * min_rr
        
        if not na(prev_swing_low) and not na(prev_swing_high)
            swing_range = prev_swing_high - prev_swing_low
            tp2 := entry_price - swing_range * fib_tp2
        if na(tp2) or tp2 > tp1
            tp2 := tp1 * 0.98
    
    [tp1, tp2]

// ═══════════════════════════════════════════════
// T-002: SİNYAL ÜRETİMİ
//   LONG:  confluence_score ≥ conf_thresh AND 1h bias up
//   SHORT: confluence_score ≥ conf_thresh AND 1h bias down
// ═══════════════════════════════════════════════

// Entry price: use close (most recent confirmed bar)
f_entry_price(direction) =>
    if direction == "LONG"
        bullish_ob_bot  // OB bottom as entry zone
    else
        bearish_ob_top  // OB top as entry zone

var float sig_entry_long  = na
var float sig_sl_long     = na
var float sig_tp1_long    = na
var float sig_tp2_long    = na
var int   sig_score_long  = na

var float sig_entry_short = na
var float sig_sl_short    = na
var float sig_tp1_short   = na
var float sig_tp2_short   = na
var int   sig_score_short = na

long_signal  = false
short_signal = false

// Only generate signals on confirmed bars, when OB is active and confluence meets threshold
if barstate.isconfirmed
    // --- LONG signal ---
    if bullish_ob_active and confluence_score_long >= conf_thresh and htf_bias_up
        ln_entry = f_entry_price("LONG")
        ln_sl    = f_calc_sl("LONG", ln_entry)
        ln_tp    = f_calc_tp("LONG", ln_entry, ln_sl)
        ln_tp1   = ln_tp[0]
        ln_tp2   = ln_tp[1]
        
        // Validity checks
        valid = not na(ln_sl) and not na(ln_tp1) and ln_sl < ln_entry and ln_tp1 > ln_entry
        if valid
            long_signal := true
            sig_entry_long  := ln_entry
            sig_sl_long     := ln_sl
            sig_tp1_long    := ln_tp1
            sig_tp2_long    := ln_tp2
            sig_score_long  := confluence_score_long
    
    // --- SHORT signal ---
    if bearish_ob_active and confluence_score_short >= conf_thresh and htf_bias_down
        sh_entry = f_entry_price("SHORT")
        sh_sl    = f_calc_sl("SHORT", sh_entry)
        sh_tp    = f_calc_tp("SHORT", sh_entry, sh_sl)
        sh_tp1   = sh_tp[0]
        sh_tp2   = sh_tp[1]
        
        valid = not na(sh_sl) and not na(sh_tp1) and sh_sl > sh_entry and sh_tp1 < sh_entry
        if valid
            short_signal := true
            sig_entry_short := sh_entry
            sig_sl_short    := sh_sl
            sig_tp1_short   := sh_tp1
            sig_tp2_short   := sh_tp2
            sig_score_short := confluence_score_short

// ═══════════════════════════════════════════════
// T-002: SL/TP GÖRSEL PLOT — Plan §4
// ═══════════════════════════════════════════════

// Plot SL/TP for most recent LONG signal
if show_sltp and not na(sig_entry_long)
    // SL line — orange-red, dashed, 2px (§4c)
    line.new(bar_index, sig_sl_long,  bar_index + 20, sig_sl_long,
     col_sl, 2, line.style_dashed)
    // TP1 line — light green, dashed, 1px
    line.new(bar_index, sig_tp1_long, bar_index + 20, sig_tp1_long,
     col_tp1, 1, line.style_dashed)
    // TP2 line — blue, dashed, 1px
    if not na(sig_tp2_long) and sig_tp2_long > sig_tp1_long
        line.new(bar_index, sig_tp2_long, bar_index + 20, sig_tp2_long,
         col_tp2, 1, line.style_dashed)
    // Entry marker — green triangle up (§4c)
    label.new(bar_index, sig_entry_long,
     "LONG " + str.tostring(sig_score_long, "0") + "%",
     style=label.style_label_up,
     color=color.new(col_long, 90), textcolor=col_long, size=size.small)
    // Entry zone box
    if bullish_ob_active
        box.new(bullish_ob_bar, bullish_ob_top,
         bar_index + 20, bullish_ob_bot,
         col_long, 1, line.style_dashed,
         bgcolor=color.new(col_long, 15))

// Plot SL/TP for most recent SHORT signal
if show_sltp and not na(sig_entry_short)
    line.new(bar_index, sig_sl_short,  bar_index + 20, sig_sl_short,
     col_sl, 2, line.style_dashed)
    line.new(bar_index, sig_tp1_short, bar_index + 20, sig_tp1_short,
     col_tp1, 1, line.style_dashed)
    if not na(sig_tp2_short) and sig_tp2_short < sig_tp1_short
        line.new(bar_index, sig_tp2_short, bar_index + 20, sig_tp2_short,
         col_tp2, 1, line.style_dashed)
    label.new(bar_index, sig_entry_short,
     "SHORT " + str.tostring(sig_score_short, "0") + "%",
     style=label.style_label_down,
     color=color.new(col_short, 90), textcolor=col_short, size=size.small)
    if bearish_ob_active
        box.new(bearish_ob_bar, bearish_ob_top,
         bar_index + 20, bearish_ob_bot,
         col_short, 1, line.style_dashed,
         bgcolor=color.new(col_short, 15))

// ═══════════════════════════════════════════════
// VISUAL OUTPUTS — Plan §4 (T-001: swing + bias)
// ═══════════════════════════════════════════════

// --- Swing labels ---
if barstate.isconfirmed and new_swing_high
    label.new(bar_index - lb, swing_high_val,
     "HH", style=label.style_label_down,
     color=color.new(col_swing, 90), textcolor=col_swing, size=size.small)

if barstate.isconfirmed and new_swing_low
    label.new(bar_index - lb, swing_low_val,
     "LL", style=label.style_label_up,
     color=color.new(col_swing, 90), textcolor=col_swing, size=size.small)

// --- 1h bias trend ---
bias_color = htf_bias_up ? col_long : htf_bias_down ? col_short : col_trend

// Plot 1h EMA20 on the 15m chart (informational overlay)
plot_htf = request.security(htf_sym, htf_tf,
 ta.ema(close, 20), lookahead=barmerge.lookahead_off)

plot(plot_htf, "1H EMA20", col_trend, 2, plot.style_line)

// --- Bias text in a table (non-intrusive) ---
var table bias_table = table.new(position.top_right, 1, 1,
 border_width=0, frame_width=0)

if barstate.islastconfirmedhistory
    h1_text = htf_bias_up ? "▲ 1H BULL" : htf_bias_down ? "▼ 1H BEAR" : "— 1H FLAT"
    h1_color = htf_bias_up ? col_long : htf_bias_down ? col_short : col_trend
    table.cell(bias_table, 0, 0, h1_text, text_color=h1_color, text_size=size.small)
    table.cell_set_bgcolor(bias_table, 0, 0, color.new(#000000, 80))

// ═══════════════════════════════════════════════
// ALERT CONDITIONS — T-002: sinyal üretimine bağlı
// ═══════════════════════════════════════════════

alertcondition(long_signal,  "Efloud LONG",  "LONG setup detected")
alertcondition(short_signal, "Efloud SHORT", "SHORT setup detected")
