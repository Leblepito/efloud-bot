//@version=6
// ═══════════════════════════════════════════════
// u2algo Wave-1 — SMC Indicator (P-001 / T-001..T-003)
// 15m trigger + 1h bias overlay
// v1.2.0 — round-6 SENKRON-port: FVG + EQH/EQL + Breaker zone detektörleri
//          (görsel) + zone-pullback entry + R:R/swing TP görseli.
//          INDICATOR emir VERMEZ — sadece çizer.
// v1.2.1 — PR #198 review-fix: OB cnt>=1 (engine SENKRON, smc.py:216 — tam-5 değil),
//          confluence near-swing window-gate (bayat +15 fix), EQH/EQL 5-komşu
//          penceresi (smc.py:311), FVG mitigation no-op + dead array temizliği.
// v1.3.0 — GÖRSEL POLISH (approach A): katman toggle'ları (Görünüm) + çizim
//          yaşam-döngüsü (handle-tracked: yalnız SON sinyalin SL/TP'si + son N
//          zone çizilir → spaghetti/kutu-duvarı gider) + bgcolor opaklık düşür +
//          kenarlık + net renk semantiği + zengin info-table. SADECE GÖRSEL —
//          sinyal/SL/TP/confluence LOGIC'i byte-eşdeğer (değişmedi).
// ═══════════════════════════════════════════════
//
// © u2algo — Efloud SMC Core · Pine Script v6 · INDICATOR (free, lead magnet)
// STRATEGY version: pine/u2algo/wave1_strategy.pine (premium, T-003)
//
// ⚠️ TASARIM NOTU (RE10045 by-pass): Bu indicator tüm SMC mantığını **inline**
//    hesaplar — user-defined function YOK. Strategy'nin (wave1_strategy.pine)
//    çok-adaylı engine-TP/zone fonksiyonları (f_engine_tp/f_nearest_zone/
//    f_calc_sl/f_eq_levels) tam-script bağlamında TradingView'de RE10045 runtime
//    hatası veriyordu (her biri izole TEMİZ; hata yalnız hepsi + gerçek detection
//    birlikteyken). Lead-magnet'in değeri görsel zone/likidite/FVG/breaker tespiti
//    olduğundan, sinyal SL/TP mantığı sadeleştirilip inline edildi. SENKRON: input
//    isimleri + detektörler (OB/FVG/EQH-EQL/Breaker) strategy ile aynı.
//
// NOT: pine/efloud_signals.pine (SMC v2 sadık port) AYRI üründür — değiştirilmez.

indicator(
 "u2algo SMC — Wave 1",
 overlay=true,
 format=format.price,
 max_bars_back=500,
 max_labels_count=500,
 max_boxes_count=500,
 max_lines_count=500
)

// ═══════════════════════════════════════════════
// INPUTS — strategy ile SENKRON (çekirdek param.)
// ═══════════════════════════════════════════════
ob_seq_group   = "Order Block"
ob_seq_default = 5
ob_body_mult   = input.float(1.5, "OB Body/ATR Mult", minval=0.5, maxval=5.0, step=0.1,
 tooltip="Breakout body must exceed this × ATR(14)", group=ob_seq_group)

confluence_group = "Confluence & Risk"
conf_thresh = input.int(55, "Confluence Threshold", minval=0, maxval=100,
 tooltip="Minimum confluence score for signal validity (live-prod: 80)", group=confluence_group)
sl_lb     = input.int(20, "SL Lookback Bars", minval=5, maxval=50,
 tooltip="Number of bars to scan for structural SL level", group=confluence_group)
sl_atr_m  = input.float(0.5, "SL ATR Buffer", minval=0.1, maxval=2.0, step=0.1,
 tooltip="ATR(14) multiplier for SL buffer", group=confluence_group)
min_rr    = input.float(1.5, "Min R:R", minval=1.0, maxval=5.0, step=0.1,
 tooltip="Minimum (TP1−entry)/(entry−SL) ratio (live-prod: 1.8)", group=confluence_group)
fib_tp2   = input.float(1.618, "Fib TP2 Extension", minval=1.0, maxval=3.0, step=0.1,
 tooltip="Fibonacci extension from swing range for TP2 target", group=confluence_group)

// ═══════════════════════════════════════════════
// GÖRÜNÜM (katman toggle'ları) — v1.3.0 polish
//   Default: temiz + screenshot-hazır. Her çizim flag'e gate'li.
// ═══════════════════════════════════════════════
visual_group = "Görünüm"
show_signals   = input.bool(true,  "Sinyal SL/TP/Entry", group=visual_group,
 tooltip="Yalnız SON aktif setup'ın SL/TP/entry çizgileri + etiketi (geçmiş spaghetti YOK)")
show_zones     = input.bool(true,  "Order Block Zone'ları", group=visual_group,
 tooltip="Demand (yeşil) / Supply (kırmızı) OB kutuları — son N tanesi")
show_fvg       = input.bool(true,  "FVG Zone'ları", group=visual_group,
 tooltip="Fair Value Gap kutuları (engine smc.py:38-44) — son N tanesi")
show_breaker   = input.bool(true,  "Breaker (BB) İşaretleri", group=visual_group,
 tooltip="OB kırılınca (close zone'dan geçince) breaker işareti")
show_liquidity = input.bool(true,  "EQH/EQL Likidite", group=visual_group,
 tooltip="Equal Highs/Lows likidite seviyeleri (engine smc.py pairwise)")
show_labels    = input.bool(true,  "Swing HH/LL Etiketleri", group=visual_group,
 tooltip="Onaylı swing high/low etiketleri (son birkaç tanesi)")
show_bgcolor   = input.bool(false, "Zone Dolgusu (bgcolor)", group=visual_group,
 tooltip="KAPALI (default): zone'lar yalnız kenarlık (temiz). AÇIK: çok-düşük-opaklık dolgu")
show_table     = input.bool(true,  "Info Panel (table)", group=visual_group,
 tooltip="Köşe paneli: 1H bias / confluence / setup / entry / SL / R:R")
max_zones      = input.int(6, "Max Görünür Zone", minval=1, maxval=20, group=visual_group,
 tooltip="Yalnız son N OB / FVG zone çizilir (kutu-duvarı önler)")
use_cb_palette = input.bool(false, "Renk-Körü Dostu Palet", group=visual_group)

r1_group = "T-003 R1 — Signal Tuning"
ob_active_window_bars = input.int(15, "OB Active Window (bars)", minval=1, maxval=50,
 tooltip="OB-aktif penceresi (eski: hardcoded 5). 3× daha uzun hafıza — strategy SENKRON.",
 group=r1_group)

// ═══════════════════════════════════════════════
// COLOR PALETTE — net semantik (Plan §4 + polish §5)
//   bullish=yeşil · bearish=kırmızı · zone=yön-renkli düşük-opaklık · nötr=gri
// ═══════════════════════════════════════════════
base_long  = use_cb_palette ? #4488FF : #00E18A
base_short = use_cb_palette ? #FF8800 : #FF4D5E
base_sl    = use_cb_palette ? #FF0000 : #FF5544
base_tp1   = use_cb_palette ? #00CC44 : #3FD188
base_tp2   = use_cb_palette ? #AA44FF : #4D9BFF
base_fvg   = use_cb_palette ? #9C6ADE : #A06BFF
base_liq   = use_cb_palette ? #FFC107 : #FFA000
base_bb    = #FF66CC
base_swing = #9AA0A6
base_trend = #808890

col_long  = color.new(base_long,  0)
col_short = color.new(base_short, 0)
col_sl    = color.new(base_sl,    0)
col_tp1   = color.new(base_tp1,   0)
col_tp2   = color.new(base_tp2,   0)
col_bb    = color.new(base_bb,    0)
col_swing = color.new(base_swing, 0)
col_liq   = color.new(base_liq,   20)
col_trend = color.new(base_trend, 25)

// zone kenarlık + (opsiyonel) çok-düşük-opaklık dolgu
dem_border = color.new(base_long,  35)
sup_border = color.new(base_short, 35)
fvg_border = color.new(base_fvg,   55)
dem_fill   = show_bgcolor ? color.new(base_long,  90) : na
sup_fill   = show_bgcolor ? color.new(base_short, 90) : na
fvg_fill   = show_bgcolor ? color.new(base_fvg,   90) : na

// ═══════════════════════════════════════════════
// ATR + 1H BIAS
// ═══════════════════════════════════════════════
atr14 = ta.atr(14)
htf_sym = syminfo.tickerid
htf_tf  = "60"
htf_close = request.security(htf_sym, htf_tf, close, lookahead=barmerge.lookahead_off)
htf_high  = request.security(htf_sym, htf_tf, high,  lookahead=barmerge.lookahead_off)
htf_low   = request.security(htf_sym, htf_tf, low,   lookahead=barmerge.lookahead_off)
htf_ema20 = ta.ema(htf_close, 20)
htf_bias_up   = htf_close > htf_ema20
htf_bias_down = htf_close < htf_ema20

// ═══════════════════════════════════════════════
// SWING DETECTION (lb=4, repaint-safe: lb-bar gecikmeli)
// ═══════════════════════════════════════════════
lb = 4
is_swing_high = false
swing_high_val = 0.0
if barstate.isconfirmed and bar_index >= lb * 2
    is_swing_high := true
    for j = 1 to lb
        if high[lb] <= high[lb - j] or high[lb] <= high[lb + j]
            is_swing_high := false
            break
    if is_swing_high
        swing_high_val := high[lb]
new_swing_high = is_swing_high

is_swing_low = false
swing_low_val = 0.0
if barstate.isconfirmed and bar_index >= lb * 2
    is_swing_low := true
    for j = 1 to lb
        if low[lb] >= low[lb - j] or low[lb] >= low[lb + j]
            is_swing_low := false
            break
    if is_swing_low
        swing_low_val := low[lb]
new_swing_low = is_swing_low

var float last_sh_price = na
var int   last_sh_bar   = na
var float last_sl_price = na
var int   last_sl_bar   = na
if barstate.isconfirmed
    if new_swing_high
        last_sh_price := swing_high_val
        last_sh_bar   := bar_index - lb
    if new_swing_low
        last_sl_price := swing_low_val
        last_sl_bar   := bar_index - lb

// EQH/EQL swing history (engine smc.py pairwise) — round-6
var array<float> sh_arr = array.new<float>()
var array<float> sl_arr = array.new<float>()
int SW_CAP = 30
if barstate.isconfirmed and new_swing_high
    array.push(sh_arr, swing_high_val)
    if array.size(sh_arr) > SW_CAP
        array.shift(sh_arr)
if barstate.isconfirmed and new_swing_low
    array.push(sl_arr, swing_low_val)
    if array.size(sl_arr) > SW_CAP
        array.shift(sl_arr)

// ═══════════════════════════════════════════════
// ORDER BLOCK + BREAKER ZONE ARRAY (engine smc.py:200-256) — round-6
//   v1.3.0: çizilen kutular handle-tracked (var array<box>) → son N tanesi
// ═══════════════════════════════════════════════
bar_bull = close > open
bar_bear = close < open
bar_body = math.abs(close - open)
is_breakout_body = bar_body > ob_body_mult * atr14

var array<float> ob_top = array.new<float>()
var array<float> ob_bot = array.new<float>()
var array<int>   ob_dir = array.new<int>()   // 1=demand(LONG), -1=supply(SHORT)
var array<int>   ob_bar = array.new<int>()
var array<bool>  ob_brk = array.new<bool>()
var array<box>   ob_boxes = array.new<box>() // çizim handle'ları (görsel cap)
int OB_CAP = 30

bull_breakout = barstate.isconfirmed and bar_bull and is_breakout_body
var int  bullish_ob_bar = na
var bool bullish_ob_near_swing = false
if bull_breakout
    cnt = 0
    hi = 0.0
    lo = 1e10
    for k = 1 to ob_seq_default
        if bar_index - k >= 0 and close[k] < open[k]
            ct_i = open[k]
            cb_i = close[k]
            if cnt == 0
                hi := ct_i
                lo := cb_i
            else
                hi := math.max(hi, ct_i)
                lo := math.min(lo, cb_i)
            cnt += 1
        else if cnt > 0
            break
    if cnt >= 1 and hi > lo
        ns = false
        if not na(last_sl_price)
            dpc = math.abs(lo - last_sl_price) / last_sl_price
            bsl = bar_index - last_sl_bar
            ns := dpc < 0.015 and bsl > 0 and bsl < 30
        bullish_ob_bar := bar_index - cnt
        bullish_ob_near_swing := ns
        array.push(ob_top, hi)
        array.push(ob_bot, lo)
        array.push(ob_dir, 1)
        array.push(ob_bar, bar_index - cnt)
        array.push(ob_brk, false)
        if array.size(ob_top) > OB_CAP
            array.shift(ob_top)
            array.shift(ob_bot)
            array.shift(ob_dir)
            array.shift(ob_bar)
            array.shift(ob_brk)
        if show_zones
            array.push(ob_boxes, box.new(bullish_ob_bar, hi, bar_index, lo,
             border_color=dem_border, border_width=1, border_style=line.style_solid, bgcolor=dem_fill))

bear_breakout = barstate.isconfirmed and bar_bear and is_breakout_body
var int  bearish_ob_bar = na
var bool bearish_ob_near_swing = false
if bear_breakout
    cnt = 0
    hi = 0.0
    lo = 1e10
    for k = 1 to ob_seq_default
        if bar_index - k >= 0 and close[k] > open[k]
            ct_i = close[k]
            cb_i = open[k]
            if cnt == 0
                hi := ct_i
                lo := cb_i
            else
                hi := math.max(hi, ct_i)
                lo := math.min(lo, cb_i)
            cnt += 1
        else if cnt > 0
            break
    if cnt >= 1 and hi > lo
        ns = false
        if not na(last_sh_price)
            dpc = math.abs(hi - last_sh_price) / last_sh_price
            bsh = bar_index - last_sh_bar
            ns := dpc < 0.015 and bsh > 0 and bsh < 30
        bearish_ob_bar := bar_index - cnt
        bearish_ob_near_swing := ns
        array.push(ob_top, hi)
        array.push(ob_bot, lo)
        array.push(ob_dir, -1)
        array.push(ob_bar, bar_index - cnt)
        array.push(ob_brk, false)
        if array.size(ob_top) > OB_CAP
            array.shift(ob_top)
            array.shift(ob_bot)
            array.shift(ob_dir)
            array.shift(ob_bar)
            array.shift(ob_brk)
        if show_zones
            array.push(ob_boxes, box.new(bearish_ob_bar, hi, bar_index, lo,
             border_color=sup_border, border_width=1, border_style=line.style_solid, bgcolor=sup_fill))

// görsel zone cap: yalnız son max_zones OB kutusu kalır → kutu-duvarı yok
if array.size(ob_boxes) > max_zones
    box.delete(array.shift(ob_boxes))

// breaker flip: close OB içinden geçince yönü flip + breaker işaretle
var array<label> bb_lbls = array.new<label>()
if array.size(ob_top) > 0
    for i = 0 to array.size(ob_top) - 1
        if not array.get(ob_brk, i) and bar_index - array.get(ob_bar, i) >= 2
            d = array.get(ob_dir, i)
            flipped = false
            if d == 1 and close < array.get(ob_bot, i)
                array.set(ob_dir, i, -1)
                array.set(ob_brk, i, true)
                flipped := true
            else if d == -1 and close > array.get(ob_top, i)
                array.set(ob_dir, i, 1)
                array.set(ob_brk, i, true)
                flipped := true
            if flipped and show_breaker
                bbe = d == 1 ? array.get(ob_bot, i) : array.get(ob_top, i)
                bst = d == 1 ? label.style_label_up : label.style_label_down
                array.push(bb_lbls, label.new(bar_index, bbe, "BB", style=bst, color=col_bb,
                 textcolor=color.white, size=size.tiny))
if array.size(bb_lbls) > 6
    label.delete(array.shift(bb_lbls))

// ═══════════════════════════════════════════════
// FVG DETECTION (engine smc.py:38-44) — round-6 (görsel-only; mitigation no-op dropped, §9e)
//   v1.3.0: handle-tracked → son max_zones FVG kutusu kalır
// ═══════════════════════════════════════════════
var array<box> fvg_boxes = array.new<box>()
if barstate.isconfirmed and show_fvg
    if low > high[2]
        array.push(fvg_boxes, box.new(bar_index - 2, low, bar_index + 3, high[2], border_color=fvg_border, border_width=1, bgcolor=fvg_fill))
    if high < low[2]
        array.push(fvg_boxes, box.new(bar_index - 2, low[2], bar_index + 3, high, border_color=fvg_border, border_width=1, bgcolor=fvg_fill))
if array.size(fvg_boxes) > max_zones
    box.delete(array.shift(fvg_boxes))

// ═══════════════════════════════════════════════
// CONFLUENCE SCORING (Plan §2a) — strategy SENKRON
// ═══════════════════════════════════════════════
bullish_ob_active = (bar_index - bullish_ob_bar) <= ob_active_window_bars and bullish_ob_bar > 0
bearish_ob_active = (bar_index - bearish_ob_bar) <= ob_active_window_bars and bearish_ob_bar > 0
htf_ema_slope = (htf_ema20 - htf_ema20[1]) / htf_ema20[1] * 100
bullish_fvg = low > high[2]
bearish_fvg = high < low[2]

var float prev_swing_high = na
var float prev_swing_low  = na
if barstate.isconfirmed
    if new_swing_high
        prev_swing_high := swing_high_val
    if new_swing_low
        prev_swing_low := swing_low_val
recent_higher_high = not na(prev_swing_high) and high > prev_swing_high and (bar_index - last_sh_bar) < 50
recent_lower_low   = not na(prev_swing_low)  and low  < prev_swing_low  and (bar_index - last_sl_bar) < 50

confluence_score_long = 0
confluence_score_long := bullish_ob_active ? confluence_score_long + 30 : confluence_score_long
confluence_score_long := (bullish_ob_active and bullish_ob_near_swing) ? confluence_score_long + 15 : confluence_score_long
confluence_score_long := bull_breakout and bar_body > 2.0 * atr14 ? confluence_score_long + 10 : confluence_score_long
confluence_score_long := htf_bias_up ? confluence_score_long + 20 : confluence_score_long
confluence_score_long := htf_ema_slope > 0.1 ? confluence_score_long + 10 : confluence_score_long
confluence_score_long := bullish_fvg ? confluence_score_long + 5 : confluence_score_long
confluence_score_long := recent_higher_high ? confluence_score_long + 10 : confluence_score_long
confluence_score_long := math.min(100, confluence_score_long)

confluence_score_short = 0
confluence_score_short := bearish_ob_active ? confluence_score_short + 30 : confluence_score_short
confluence_score_short := (bearish_ob_active and bearish_ob_near_swing) ? confluence_score_short + 15 : confluence_score_short
confluence_score_short := bear_breakout and bar_body > 2.0 * atr14 ? confluence_score_short + 10 : confluence_score_short
confluence_score_short := htf_bias_down ? confluence_score_short + 20 : confluence_score_short
confluence_score_short := htf_ema_slope < -0.1 ? confluence_score_short + 10 : confluence_score_short
confluence_score_short := bearish_fvg ? confluence_score_short + 5 : confluence_score_short
confluence_score_short := recent_lower_low ? confluence_score_short + 10 : confluence_score_short
confluence_score_short := math.min(100, confluence_score_short)

// ═══════════════════════════════════════════════
// 1H SWING LEVELS — B1 repaint fix (pivot adayı [3], komşular [3±j])
// ═══════════════════════════════════════════════
var float last_1h_swing_high = na
var float last_1h_swing_low  = na
if barstate.isconfirmed
    is_1h_sh = true
    for j = 1 to 3
        if htf_high[3] <= htf_high[3 + j] or htf_high[3] <= htf_high[3 - j]
            is_1h_sh := false
            break
    if is_1h_sh
        last_1h_swing_high := htf_high[3]
    is_1h_sl = true
    for j = 1 to 3
        if htf_low[3] >= htf_low[3 + j] or htf_low[3] >= htf_low[3 - j]
            is_1h_sl := false
            break
    if is_1h_sl
        last_1h_swing_low := htf_low[3]

// ═══════════════════════════════════════════════
// SİNYAL + SL/TP — INLINE (user-defined function YOK; RE10045 by-pass)
//   entry = en yakın aktif zone near-edge (OB|BB inline tarama)
//   SL    = ta.lowest/highest ± ATR buffer (her bar hesaplanır)
//   TP1   = en yakın 1h swing (RR sağlıyorsa) yoksa RR-projeksiyon
//   TP2   = fib(1.618) projeksiyon
//   v1.3.0: hesaplanan setup birleşik ui_* var'lara yazılır (çizim + table paylaşır)
// ═══════════════════════════════════════════════
sl_lowest  = ta.lowest(low, sl_lb)
sl_highest = ta.highest(high, sl_lb)

var int   ui_dir   = 0      // 1=long, -1=short, 0=yok
var float ui_entry = na
var float ui_sl    = na
var float ui_tp1   = na
var float ui_tp2   = na
var int   ui_score = na
var int   ui_bar   = na

long_signal  = false
short_signal = false

if barstate.isconfirmed
    // --- LONG ---
    if htf_bias_up and (recent_higher_high or confluence_score_long >= conf_thresh)
        // nearest demand zone near-edge below close (inline)
        float ln_entry = na
        ln_best  = 1e20
        if array.size(ob_top) > 0
            for i = 0 to array.size(ob_top) - 1
                if array.get(ob_dir, i) == 1
                    e = array.get(ob_top, i)
                    if e < close and (close - e) < ln_best
                        ln_best := close - e
                        ln_entry := e
        if not na(ln_entry)
            sl_buf  = sl_atr_m * atr14
            sl_min  = math.max(0.5 * atr14, 0.001 * ln_entry)
            ln_sl   = sl_lowest - sl_buf
            if ln_entry - ln_sl < sl_min
                ln_sl := ln_entry - sl_min
            risk = ln_entry - ln_sl
            ln_tp1 = (not na(last_1h_swing_high) and last_1h_swing_high > ln_entry and (last_1h_swing_high - ln_entry) >= min_rr * risk) ? last_1h_swing_high : ln_entry + min_rr * risk
            ln_tp2 = ln_entry + fib_tp2 * risk
            if ln_sl < ln_entry and ln_tp1 > ln_entry
                long_signal := true
                ui_dir   := 1
                ui_entry := ln_entry
                ui_sl    := ln_sl
                ui_tp1   := ln_tp1
                ui_tp2   := ln_tp2
                ui_score := confluence_score_long
                ui_bar   := bar_index
    // --- SHORT ---
    if htf_bias_down and (recent_lower_low or confluence_score_short >= conf_thresh)
        float sh_entry = na
        sh_best  = 1e20
        if array.size(ob_top) > 0
            for i = 0 to array.size(ob_top) - 1
                if array.get(ob_dir, i) == -1
                    e = array.get(ob_bot, i)
                    if e > close and (e - close) < sh_best
                        sh_best := e - close
                        sh_entry := e
        if not na(sh_entry)
            sl_buf = sl_atr_m * atr14
            sl_min = math.max(0.5 * atr14, 0.001 * sh_entry)
            sh_sl  = sl_highest + sl_buf
            if sh_sl - sh_entry < sl_min
                sh_sl := sh_entry + sl_min
            risk = sh_sl - sh_entry
            sh_tp1 = (not na(last_1h_swing_low) and last_1h_swing_low < sh_entry and (sh_entry - last_1h_swing_low) >= min_rr * risk) ? last_1h_swing_low : sh_entry - min_rr * risk
            sh_tp2 = sh_entry - fib_tp2 * risk
            if sh_sl > sh_entry and sh_tp1 < sh_entry
                short_signal := true
                ui_dir   := -1
                ui_entry := sh_entry
                ui_sl    := sh_sl
                ui_tp1   := sh_tp1
                ui_tp2   := sh_tp2
                ui_score := confluence_score_short
                ui_bar   := bar_index

// ═══════════════════════════════════════════════
// SL/TP GÖRSEL — yalnız SON sinyal (handle-tracked: geçmiş spaghetti YOK)
// ═══════════════════════════════════════════════
var line  sig_sl_ln    = na
var line  sig_tp1_ln   = na
var line  sig_tp2_ln   = na
var line  sig_entry_ln = na
var label sig_lbl       = na
new_signal = long_signal or short_signal
if show_signals and new_signal
    line.delete(sig_sl_ln)
    line.delete(sig_tp1_ln)
    line.delete(sig_tp2_ln)
    line.delete(sig_entry_ln)
    label.delete(sig_lbl)
    c_dir = ui_dir == 1 ? col_long : col_short
    sig_sl_ln    := line.new(bar_index, ui_sl,    bar_index + 25, ui_sl,    color=col_sl,  width=2, style=line.style_dashed)
    sig_tp1_ln   := line.new(bar_index, ui_tp1,   bar_index + 25, ui_tp1,   color=col_tp1, width=1, style=line.style_dashed)
    has_tp2 = ui_dir == 1 ? ui_tp2 > ui_tp1 : ui_tp2 < ui_tp1
    if has_tp2
        sig_tp2_ln := line.new(bar_index, ui_tp2, bar_index + 25, ui_tp2, color=col_tp2, width=1, style=line.style_dashed)
    else
        sig_tp2_ln := na
    sig_entry_ln := line.new(bar_index, ui_entry, bar_index + 25, ui_entry, color=c_dir, width=1, style=line.style_dotted)
    lstyle = ui_dir == 1 ? label.style_label_up : label.style_label_down
    ltext  = (ui_dir == 1 ? "LONG " : "SHORT ") + str.tostring(ui_score, "0") + "%"
    sig_lbl := label.new(bar_index, ui_entry, ltext, style=lstyle, color=color.new(c_dir, 80), textcolor=c_dir, size=size.small)

// ═══════════════════════════════════════════════
// SWING LABELS + 1H EMA + EQH/EQL LIQUIDITY + INFO PANEL
// ═══════════════════════════════════════════════
var array<label> swing_lbls = array.new<label>()
if show_labels and barstate.isconfirmed and new_swing_high
    array.push(swing_lbls, label.new(bar_index - lb, swing_high_val, "HH", style=label.style_label_down,
     color=color.new(base_swing, 92), textcolor=col_swing, size=size.tiny))
if show_labels and barstate.isconfirmed and new_swing_low
    array.push(swing_lbls, label.new(bar_index - lb, swing_low_val, "LL", style=label.style_label_up,
     color=color.new(base_swing, 92), textcolor=col_swing, size=size.tiny))
if array.size(swing_lbls) > 8
    label.delete(array.shift(swing_lbls))

plot_htf = request.security(htf_sym, htf_tf, ta.ema(close, 20), lookahead=barmerge.lookahead_off)
plot(plot_htf, "1H EMA20", col_trend, 1, plot.style_line)

// EQH/EQL likidite — son onaylı bar'da INLINE pairwise (handle-tracked, max 4'er)
var array<line>  eq_lines = array.new<line>()
var array<label> eq_lbls  = array.new<label>()
if show_liquidity and barstate.islastconfirmedhistory
    while array.size(eq_lines) > 0
        line.delete(array.shift(eq_lines))
    while array.size(eq_lbls) > 0
        label.delete(array.shift(eq_lbls))
    //  NOT: dedup nested-loop denendi → RE10045 (inline-heavy bağlamda Pine
    //  karmaşıklık limiti). Scalar last-level dedup (tek karşılaştırma) ile
    //  etiket yığılmasını ucuz azalt — nested loop YOK.
    nh = array.size(sh_arr)
    drawn_h = 0
    float last_h = na
    if nh >= 2
        for i = 0 to nh - 2
            for j = i + 1 to math.min(i + 4, nh - 1)
                if drawn_h < 4
                    a = array.get(sh_arr, i)
                    b = array.get(sh_arr, j)
                    if math.abs(a - b) / math.max(a, 1e-10) <= 0.001
                        lvl = (a + b) / 2
                        if na(last_h) or math.abs(last_h - lvl) / math.max(lvl, 1e-10) > 0.003
                            last_h := lvl
                            array.push(eq_lines, line.new(bar_index - 40, lvl, bar_index + 12, lvl, color=col_liq, width=1, style=line.style_dotted))
                            array.push(eq_lbls, label.new(bar_index + 12, lvl, "EQH", style=label.style_label_left,
                             color=color.new(base_liq, 55), textcolor=color.white, size=size.tiny))
                            drawn_h += 1
    nl = array.size(sl_arr)
    drawn_l = 0
    float last_l = na
    if nl >= 2
        for i = 0 to nl - 2
            for j = i + 1 to math.min(i + 4, nl - 1)
                if drawn_l < 4
                    a = array.get(sl_arr, i)
                    b = array.get(sl_arr, j)
                    if math.abs(a - b) / math.max(a, 1e-10) <= 0.001
                        lvl = (a + b) / 2
                        if na(last_l) or math.abs(last_l - lvl) / math.max(lvl, 1e-10) > 0.003
                            last_l := lvl
                            array.push(eq_lines, line.new(bar_index - 40, lvl, bar_index + 12, lvl, color=col_liq, width=1, style=line.style_dotted))
                            array.push(eq_lbls, label.new(bar_index + 12, lvl, "EQL", style=label.style_label_left,
                             color=color.new(base_liq, 55), textcolor=color.white, size=size.tiny))
                            drawn_l += 1

// INFO PANEL — bias / confluence / setup / entry / SL / R:R (kompakt, köşe)
var table info_tbl = table.new(position.top_right, 2, 6, border_width=1, frame_width=1, frame_color=color.new(#000000, 60))
if show_table and barstate.islastconfirmedhistory
    bg = color.new(#0B0E11, 12)
    h1_text  = htf_bias_up ? "▲ BULL" : htf_bias_down ? "▼ BEAR" : "— FLAT"
    h1_color = htf_bias_up ? col_long : htf_bias_down ? col_short : col_trend
    table.cell(info_tbl, 0, 0, "1H BIAS", text_color=col_trend, text_size=size.small, bgcolor=bg)
    table.cell(info_tbl, 1, 0, h1_text, text_color=h1_color, text_size=size.small, bgcolor=bg)
    cl   = math.max(confluence_score_long, confluence_score_short)
    cdir = confluence_score_long >= confluence_score_short ? "L" : "S"
    table.cell(info_tbl, 0, 1, "CONF", text_color=col_trend, text_size=size.small, bgcolor=bg)
    table.cell(info_tbl, 1, 1, cdir + " " + str.tostring(cl, "0") + "%", text_color=color.white, text_size=size.small, bgcolor=bg)
    has_setup = not na(ui_entry)
    s_txt = has_setup ? (ui_dir == 1 ? "LONG " : "SHORT ") + str.tostring(ui_score, "0") + "%" : "—"
    s_col = has_setup ? (ui_dir == 1 ? col_long : col_short) : col_trend
    table.cell(info_tbl, 0, 2, "SETUP", text_color=col_trend, text_size=size.small, bgcolor=bg)
    table.cell(info_tbl, 1, 2, s_txt, text_color=s_col, text_size=size.small, bgcolor=bg)
    table.cell(info_tbl, 0, 3, "ENTRY", text_color=col_trend, text_size=size.small, bgcolor=bg)
    table.cell(info_tbl, 1, 3, has_setup ? str.tostring(ui_entry, format.mintick) : "—", text_color=color.white, text_size=size.small, bgcolor=bg)
    table.cell(info_tbl, 0, 4, "SL", text_color=col_trend, text_size=size.small, bgcolor=bg)
    table.cell(info_tbl, 1, 4, has_setup ? str.tostring(ui_sl, format.mintick) : "—", text_color=col_sl, text_size=size.small, bgcolor=bg)
    rr = float(na)
    if has_setup
        rr := ui_dir == 1 ? (ui_tp1 - ui_entry) / math.max(ui_entry - ui_sl, 1e-10) : (ui_entry - ui_tp1) / math.max(ui_sl - ui_entry, 1e-10)
    table.cell(info_tbl, 0, 5, "R:R", text_color=col_trend, text_size=size.small, bgcolor=bg)
    table.cell(info_tbl, 1, 5, has_setup ? str.tostring(rr, "0.00") : "—", text_color=color.white, text_size=size.small, bgcolor=bg)

// ═══════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════
alertcondition(long_signal,  "u2algo SMC LONG",  "u2algo Wave-1 LONG setup detected")
alertcondition(short_signal, "u2algo SMC SHORT", "u2algo Wave-1 SHORT setup detected")
