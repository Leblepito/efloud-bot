//@version=6
// =============================================================================
// EFloud Strategy — SMC v1 port (STRATEJİ / BACKTEST)
// Kaynak: engine/smc.py + engine/signals.py + engine/confluence.py
// Spec: pine/PINE_SPEC.md EK A (V1 port)
// efloud_signals_v1.pine (indikatör) ile AYNI mantık + AYNI input isimleri.
// Mantık değişirse HER İKİ V1 dosyası senkron güncellenir (CLAUDE.md kuralı).
//
// V1 = tek-geçiş confluence makinesi (V2 durum makinesi DEĞİL):
//   aligned CHoCH/BOS → confluence skoru (eşik default 50 = prod config) → SL/TP/RR → strategy.entry.
//   TP1'de %50, TP2'de kalan %50 kapanış (ortak SL). minRr default 1.8 = prod config.phase2_1k.
//
// ── Python ↔ Pine farkları (indikatörle aynı, bkz. signals_v1 başlığı + spec EK A.7) ──
//  1) Gemini AI gate çevrilemez → confluence eşiği + manuel aiSentiment input.
//  2) Tüm-geçmiş tarama → bar-bar (recency içkin).
//  3) HTF likidite TP → en-yakın tek HTF swing.
//  4) MTF CHoCH → en-son MTF CHoCH yönü.
//  5) Range deviation: Python'da ölü kod; port NİYETİ yansıtır (useIntendedDeviation).
//  6) PA Level confluence atlandı.
//  + Backtest: pyramiding=1, sadece flat iken yeni giriş; state oturum-içi (var).
//
// ✅ Pine Editor'da SIFIR HATA derlendi (2026-05-30).
// =============================================================================
strategy("EFloud Strategy v1", overlay = true, initial_capital = 10000, currency = currency.USD, commission_type = strategy.commission.percent, commission_value = 0.04, slippage = 1, pyramiding = 1, process_orders_on_close = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS  (indikatör dosyasıyla AYNI isimler — senkron şart)
// ─────────────────────────────────────────────────────────────────────────────
grpTF   = "Timeframe Chain"
// ── Trade-Horizon Profili (signals_v1 + bot config.timeframes ile senkron) ──
//   scalp = 5m/1h/12h · mid = 15m/1h/4h · long = 1h/8h/1w · custom = aşağıdaki inputlar
profileMode = input.string("mid", "Trade-Horizon Profili", options = ["scalp", "mid", "long", "custom"], group = grpTF)
customMtf   = input.timeframe("60",  "Custom MTF (profile=custom)", group = grpTF)
customHtf   = input.timeframe("240", "Custom HTF (profile=custom)", group = grpTF)
mtfTf     = profileMode == "scalp" ? "60"  : profileMode == "mid" ? "60"  : profileMode == "long" ? "480" : customMtf
htfTf     = profileMode == "scalp" ? "720" : profileMode == "mid" ? "240" : profileMode == "long" ? "W"   : customHtf
useDaily    = input.bool(false, "Daily (1d) makro filtre kullan",        group = grpTF)
dailyTf     = input.timeframe("1D", "Daily TF",                          group = grpTF)
dailyStrict = input.bool(false, "Daily filtre SERT (ters yön reddet)",   group = grpTF)

grpSwing = "SMC Primitifleri"
swingLb  = input.int(5,     "Swing lookback (pivot L/R)", minval = 1, group = grpSwing)
oteLo    = input.float(0.618, "OTE retrace lo",                       group = grpSwing)
oteHi    = input.float(0.786, "OTE retrace hi",                       group = grpSwing)
obSeq    = input.int(5,     "OB ardışık mum (max)",        minval = 1, group = grpSwing)
rangeLb  = input.int(50,    "Range lookback",              minval = 2, group = grpSwing)
htfSlope = input.float(2.0, "HTF bias slope fallback %",               group = grpSwing)
useIntendedDeviation = input.bool(false, "Range deviation NİYET modu", group = grpSwing)

grpConf = "Confluence"
minConfluence = input.int(50, "Min confluence (eşik)", minval = 0, maxval = 100, group = grpConf)
aiSentiment   = input.string("NONE", "AI macro sentiment (manuel)", options = ["NONE", "RISK_ON", "RISK_OFF"], group = grpConf)

grpRisk = "Risk (SL / TP)"
atrLen      = input.int(14,    "ATR length",                 minval = 1, group = grpRisk)
slAtrBuffer = input.float(0.5, "SL ATR buffer (baz)",                    group = grpRisk)
volAtrBuffer= input.float(0.75,"SL ATR buffer (yüksek vol)",             group = grpRisk)
minRr       = input.float(1.8, "Min R:R (TP1)",                          group = grpRisk)
fibExt      = input.float(1.618,"TP2 fib extension",                     group = grpRisk)
recencyBars = input.int(40,    "CHoCH/BOS recency (parite — içkin)", minval = 1, group = grpRisk)
riskPerTradePct = input.float(1.0,  "Risk per trade %",  minval = 0.01, group = grpRisk)
tp1ClosePct     = input.float(50.0, "TP1'de kapanış %",  minval = 1, maxval = 100, group = grpRisk)
moveSlToBe      = input.bool(true, "TP1 sonrası SL → break-even (entry)", group = grpRisk)

// ─────────────────────────────────────────────────────────────────────────────
// HTF BUNDLE (4h) — indikatörle birebir aynı
// ─────────────────────────────────────────────────────────────────────────────
htfBundle() =>
    ph = ta.pivothigh(swingLb, swingLb)
    pl = ta.pivotlow(swingLb, swingLb)
    var float lastSH = na
    var float lastSL = na
    var int   trend  = 0
    var float refSH  = na
    var float refSL  = na
    if not na(ph)
        lastSH := ph
        refSH  := ph
    if not na(pl)
        lastSL := pl
        refSL  := pl
    if not na(refSH) and close > refSH
        trend := 1
        refSH := na
    if not na(refSL) and close < refSL
        trend := -1
        refSL := na
    int trendOrig = trend
    int bias = trend
    if bias == 0 and bar_index > 40
        chg = (close - close[40]) / close[40] * 100.0
        bias := chg > htfSlope ? 1 : chg < -htfSlope ? -1 : 0
    var float bullFvgBot = na
    var float bullFvgTop = na
    var float bearFvgBot = na
    var float bearFvgTop = na
    if low > high[2]
        bullFvgBot := high[2]
        bullFvgTop := low
    if high < low[2]
        bearFvgBot := high
        bearFvgTop := low[2]
    if not na(bullFvgBot) and low <= bullFvgBot
        bullFvgBot := na
        bullFvgTop := na
    if not na(bearFvgTop) and high >= bearFvgTop
        bearFvgBot := na
        bearFvgTop := na
    // Non-repaint (2026-07-03): [1]-shift + lookahead_on = her iki rejimde SON KAPANMIS HTF bari
    [trendOrig[1], bias[1], lastSH[1], lastSL[1], bullFvgBot[1], bullFvgTop[1], bearFvgBot[1], bearFvgTop[1]]

[htfTrendOrig, htfBias, htfSwingHigh, htfSwingLow, bullFvgBot, bullFvgTop, bearFvgBot, bearFvgTop] = request.security(syminfo.tickerid, htfTf, htfBundle(), lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_off)  // non-repaint recetesi: bundle icinde [1]-shift ile birlikte

// MTF BUNDLE (1h) — son CHoCH yönü
mtfBundle() =>
    ph = ta.pivothigh(swingLb, swingLb)
    pl = ta.pivotlow(swingLb, swingLb)
    var float refSH = na
    var float refSL = na
    var int   trend = 0
    var int   lastChoch = 0
    if not na(ph)
        refSH := ph
    if not na(pl)
        refSL := pl
    if not na(refSH) and close > refSH
        if trend <= 0
            lastChoch := 1
        trend := 1
        refSH := na
    if not na(refSL) and close < refSL
        if trend >= 0
            lastChoch := -1
        trend := -1
        refSL := na
    // Non-repaint (2026-07-03): [1]-shift + lookahead_on = son kapanmis MTF bari
    lastChoch[1]

mtfChochDir = request.security(syminfo.tickerid, mtfTf, mtfBundle(), lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_off)  // non-repaint recetesi

dailyBias = 0
if useDaily
    db = request.security(syminfo.tickerid, dailyTf, ((close - close[30]) / close[30] * 100.0)[1], lookahead = barmerge.lookahead_on)  // non-repaint: kapanmis 1D bari
    dailyBias := db > 5.0 ? 1 : db < -5.0 ? -1 : 0

// ─────────────────────────────────────────────────────────────────────────────
// ENTRY TF (15m) — indikatörle birebir aynı hesaplar
// ─────────────────────────────────────────────────────────────────────────────
phL = ta.pivothigh(swingLb, swingLb)
plL = ta.pivotlow(swingLb, swingLb)

atr14   = ta.atr(atrLen)
obAtr   = ta.sma(high - low, 14)

hlSpread    = ta.sma(high - low, 14)
closeSpread = math.abs(close - close[14])
bufferMult  = closeSpread > 1.2 * hlSpread ? volAtrBuffer : slAtrBuffer
buf         = bufferMult * atr14

rngHi = ta.highest(high, rangeLb)
rngLo = ta.lowest(low,  rangeLb)
rngEq = (rngHi + rngLo) / 2.0
discount = close < rngEq
premium  = close > rngEq
priorLo = ta.lowest(low,  rangeLb)[1]
priorHi = ta.highest(high, rangeLb)[1]
devBull = useIntendedDeviation and not na(priorLo) and low  < priorLo and close > priorLo
devBear = useIntendedDeviation and not na(priorHi) and high > priorHi and close < priorHi

local20Lo = ta.lowest(low, 20)[1]
local20Hi = ta.highest(high, 20)[1]

// ─────────────────────────────────────────────────────────────────────────────
// ENTRY TF state (var)
// ─────────────────────────────────────────────────────────────────────────────
var float eLastSH = na
var float eLastSL = na
var float eRefSH  = na
var float eRefSL  = na
var int   eTrend  = 0
var int   lastBullSfpBar = na
var int   lastBearSfpBar = na

var int[]   obDir = array.new_int()
var float[] obTop = array.new_float()
var float[] obBot = array.new_float()
var float[] obEqA = array.new_float()
var bool[]  obNS  = array.new_bool()
maxObs = 50

// Aktif işlem seviyeleri
var float curSl  = na
var float curTp1 = na
var float curTp2 = na
var int   curDir = 0
var int   curScore = 0
var float curEntry = na          // break-even için giriş fiyatı
var bool  tp1Hit   = false       // TP1 dolduktan sonra SL'i BE'ye çekmek için

if barstate.isconfirmed
    // ── pivot izleri ──
    if not na(phL)
        eLastSH := phL
        eRefSH  := phL
    if not na(plL)
        eLastSL := plL
        eRefSL  := plL

    // ── SFP ──
    if not na(eLastSL) and low < eLastSL and close > eLastSL
        lastBullSfpBar := bar_index
    if not na(eLastSH) and high > eLastSH and close < eLastSH
        lastBearSfpBar := bar_index

    // ── OB mitigasyonu ──
    if array.size(obDir) > 0
        for i = array.size(obDir) - 1 to 0
            d  = array.get(obDir, i)
            tp = array.get(obTop, i)
            bt = array.get(obBot, i)
            bool mit = d == 1 ? close < bt : close > tp
            if mit
                array.remove(obDir, i)
                array.remove(obTop, i)
                array.remove(obBot, i)
                array.remove(obEqA, i)
                array.remove(obNS,  i)

    // ── Yeni OB tespiti ──
    body = math.abs(close - open)
    if close > open and body > 1.5 * obAtr
        int cnt = 0
        float ot = 0.0
        float ob = 1e20
        for k = 1 to obSeq
            if close[k] < open[k]
                ct = open[k]
                cb = close[k]
                if cnt == 0
                    ot := ct
                    ob := cb
                else
                    ot := math.max(ot, ct)
                    ob := math.min(ob, cb)
                cnt += 1
            else if cnt > 0
                break
        if cnt >= 1 and ot > ob
            bool ns = not na(eLastSL) and math.abs(ob - eLastSL) / eLastSL < 0.015
            array.push(obDir, 1)
            array.push(obTop, ot)
            array.push(obBot, ob)
            array.push(obEqA, (ot + ob) / 2.0)
            array.push(obNS,  ns)
    if close < open and body > 1.5 * obAtr
        int cnt = 0
        float ot = 0.0
        float ob = 1e20
        for k = 1 to obSeq
            if close[k] > open[k]
                ct = close[k]
                cb = open[k]
                if cnt == 0
                    ot := ct
                    ob := cb
                else
                    ot := math.max(ot, ct)
                    ob := math.min(ob, cb)
                cnt += 1
            else if cnt > 0
                break
        if cnt >= 1 and ot > ob
            bool ns = not na(eLastSH) and math.abs(ot - eLastSH) / eLastSH < 0.015
            array.push(obDir, -1)
            array.push(obTop, ot)
            array.push(obBot, ob)
            array.push(obEqA, (ot + ob) / 2.0)
            array.push(obNS,  ns)
    while array.size(obDir) > maxObs
        array.remove(obDir, 0)
        array.remove(obTop, 0)
        array.remove(obBot, 0)
        array.remove(obEqA, 0)
        array.remove(obNS,  0)

    // ── Yapı kırılımı (CHoCH veya BOS) ──
    int   breakDir = 0
    float breakPx  = na
    if not na(eRefSH) and close > eRefSH
        breakDir := 1
        breakPx  := close
        eTrend   := 1
        eRefSH   := na
    if not na(eRefSL) and close < eRefSL
        breakDir := -1
        breakPx  := close
        eTrend   := -1
        eRefSL   := na

    // ── Sinyal değerlendirmesi (sadece flat iken yeni giriş) ──
    bool aligned = breakDir != 0 and htfBias != 0 and breakDir == htfBias and strategy.position_size == 0
    if aligned
        bool isLong = breakDir == 1
        float trigPx = breakPx

        bool inHtfFvg = isLong ? (not na(bullFvgBot) and trigPx >= bullFvgBot and trigPx <= bullFvgTop) : (not na(bearFvgBot) and trigPx >= bearFvgBot and trigPx <= bearFvgTop)

        float oteTopE = na
        float oteBotE = na
        if not na(eLastSH) and not na(eLastSL) and eLastSH > eLastSL
            d = eLastSH - eLastSL
            if isLong
                oteTopE := eLastSH - d * oteLo
                oteBotE := eLastSH - d * oteHi
            else
                oteTopE := eLastSL + d * oteHi
                oteBotE := eLastSL + d * oteLo
        float oteLoB = na
        float oteHiB = na
        if not na(oteTopE)
            oteLoB := math.min(oteTopE, oteBotE)
            oteHiB := math.max(oteTopE, oteBotE)
        bool inOte = not na(oteLoB) and trigPx >= oteLoB and trigPx <= oteHiB

        bool mtfConf = mtfChochDir != 0 and mtfChochDir == htfBias

        bool hasSfp = isLong ? (not na(lastBullSfpBar) and (bar_index - lastBullSfpBar) < 10) : (not na(lastBearSfpBar) and (bar_index - lastBearSfpBar) < 10)

        bool  inOb   = false
        bool  obNsM  = false
        bool  obEqM  = false
        float obTopM = na
        float obBotM = na
        if array.size(obDir) > 0
            for i = 0 to array.size(obDir) - 1
                if array.get(obDir, i) == breakDir
                    tp = array.get(obTop, i)
                    bt = array.get(obBot, i)
                    bool near = isLong ? (trigPx >= bt and trigPx <= tp * 1.02) : (trigPx >= bt * 0.98 and trigPx <= tp)
                    if near
                        inOb   := true
                        obNsM  := array.get(obNS, i)
                        eqv    = array.get(obEqA, i)
                        obEqM  := math.abs(trigPx - eqv) / eqv < 0.003
                        obTopM := tp
                        obBotM := bt
                        break

        bool correctZone = (isLong and discount) or (not isLong and premium)
        bool hasDev      = (isLong and devBull) or (not isLong and devBear)

        // ── Confluence skoru ──
        int score = 25
        if mtfConf
            score += 20
        if inHtfFvg
            score += 15
        if inOb
            score += 10
            if obNsM
                score += 5
            if obEqM
                score += 3
        if inOte
            score += 10
        if hasSfp
            score += 10
        if correctZone
            score += 5
        if hasDev
            score += 5
        if aiSentiment == "RISK_ON"
            score += isLong ? 5 : -5
        if aiSentiment == "RISK_OFF"
            score += isLong ? -5 : 5
        if useDaily and dailyBias != 0
            score += dailyBias == htfBias ? 5 : -5
        score := math.max(0, math.min(100, score))

        bool dailyReject = useDaily and dailyStrict and dailyBias != 0 and dailyBias != htfBias

        if not dailyReject and score >= minConfluence
            // ── Entry refinement (OB > OTE) ──
            float entry = trigPx
            if inOb
                entry := isLong ? math.min(obTopM, trigPx) : math.max(obBotM, trigPx)
            else if inOte and not na(oteTopE)
                entry := isLong ? math.min(oteTopE, trigPx) : math.max(oteBotE, trigPx)

            // ── SL ──
            float sl = na
            if isLong
                float ll = local20Lo - buf
                float sw = eLastSL
                sl := na(sw) ? ll : math.max(sw, ll)
                if hasDev
                    sl := math.min(sl, rngLo - buf)
                sl := math.min(sl, entry * 0.999)
            else
                float lh = local20Hi + buf
                float sw = eLastSH
                sl := na(sw) ? lh : math.min(sw, lh)
                if hasDev
                    sl := math.max(sl, rngHi + buf)
                sl := math.max(sl, entry * 1.001)

            float risk = math.abs(entry - sl)
            if risk > 0
                // ── TP1 ──
                float tp1 = na
                bool  discovery = false
                if isLong
                    float minTp = entry + risk * minRr
                    float liq = (not na(htfSwingHigh) and htfSwingHigh >= minTp) ? htfSwingHigh : na
                    float fvgT = (not na(bullFvgTop) and bullFvgTop >= minTp) ? bullFvgTop : na
                    if hasDev
                        tp1 := math.max(rngEq, minTp)
                    else if htfTrendOrig == 0 and not na(liq)
                        tp1 := liq
                        discovery := true                // F1: Python is_discovery (htf_above_targets boş) → TP2 2.618
                    else
                        float t = na
                        if not na(liq) and not na(fvgT)
                            t := math.min(liq, fvgT)
                        else
                            t := not na(liq) ? liq : fvgT
                        if not na(t)
                            tp1 := t
                        else
                            tp1 := entry + risk * 1.272
                            discovery := true
                else
                    float minTp = entry - risk * minRr
                    float liq = (not na(htfSwingLow) and htfSwingLow <= minTp) ? htfSwingLow : na
                    float fvgB = (not na(bearFvgBot) and bearFvgBot <= minTp) ? bearFvgBot : na
                    if hasDev
                        tp1 := math.min(rngEq, minTp)
                    else if htfTrendOrig == 0 and not na(liq)
                        tp1 := liq
                        discovery := true                // F1: Python is_discovery (htf_above_targets boş) → TP2 2.618
                    else
                        float t = na
                        if not na(liq) and not na(fvgB)
                            t := math.max(liq, fvgB)
                        else
                            t := not na(liq) ? liq : fvgB
                        if not na(t)
                            tp1 := t
                        else
                            tp1 := entry - risk * 1.272
                            discovery := true

                // ── TP2 ──
                float tp2 = na
                if hasDev
                    tp2 := isLong ? rngHi : rngLo
                else if discovery
                    tp2 := isLong ? entry + risk * 2.618 : entry - risk * 2.618
                else
                    tp2 := isLong ? entry + risk * fibExt : entry - risk * fibExt

                // Target-inversion guard (Python _enforce_tp2_beyond_tp1 ile birebir)
                if isLong
                    if tp2 <= tp1
                        tp2 := math.max(tp2, tp1 + risk * 0.5, entry + risk * 2.618)
                else
                    if tp2 >= tp1
                        tp2 := math.min(tp2, tp1 - risk * 0.5, entry - risk * 2.618)

                // ── RR filtre + giriş ──
                bool tpSide = isLong ? tp1 > entry : tp1 < entry
                float rr1 = math.abs(tp1 - entry) / risk
                if tpSide and rr1 >= minRr
                    float qty = risk > 0 ? (strategy.equity * riskPerTradePct / 100.0) / risk : na
                    if not na(qty) and qty > 0
                        curSl    := sl
                        curTp1   := tp1
                        curTp2   := tp2
                        curDir   := breakDir
                        curScore := score
                        curEntry := entry
                        tp1Hit   := false
                        if isLong
                            strategy.entry("Long", strategy.long, qty = qty)
                        else
                            strategy.entry("Short", strategy.short, qty = qty)

// ─────────────────────────────────────────────────────────────────────────────
// Aktif işlem çıkışları (TP1 %50 + TP2 %50 ladder, ortak SL)
// ─────────────────────────────────────────────────────────────────────────────
if strategy.position_size != 0 and not na(curSl) and not na(curTp1)
    // TP1 dolduysa kalan (runner) SL'ini break-even'a (entry) çek
    if moveSlToBe and not tp1Hit and (curDir == 1 ? high >= curTp1 : low <= curTp1)
        tp1Hit := true
    float effStop = (tp1Hit and moveSlToBe and not na(curEntry)) ? curEntry : curSl
    if not na(curTp2)
        strategy.exit("TP1", limit = curTp1, stop = effStop, qty_percent = tp1ClosePct)
        strategy.exit("TP2", limit = curTp2, stop = effStop)
    else
        strategy.exit("TP", limit = curTp1, stop = effStop)

// Flat olunca seviyeleri temizle
// F10 (2026-07-11 spec): process_orders_on_close=true ile entry emri verilen
// barda position_size HÂLÂ 0 (fill script sonrası) — koşulsuz reset, entry
// mantığının o bar set ettiği SL/TP state'ini siliyordu → exit bloğu hiç
// kurulmuyor, pozisyon SL/TP'siz sonsuza dek açık kalıyordu. Reset yalnız
// open→flat GEÇİŞİNDE çalışmalı.
if strategy.position_size == 0 and strategy.position_size[1] != 0
    curSl  := na
    curTp1 := na
    curTp2 := na
    curDir := 0
    curEntry := na
    tp1Hit   := false

// ── Görsel (referans) ──
plot(strategy.position_size != 0 ? curSl  : na, "SL",  color = color.new(color.red, 0),   style = plot.style_linebr)
plot(strategy.position_size != 0 ? curTp1 : na, "TP1", color = color.new(color.green, 0), style = plot.style_linebr)
plot(strategy.position_size != 0 ? curTp2 : na, "TP2", color = color.new(color.green, 40), style = plot.style_linebr)
