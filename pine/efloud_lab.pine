indicator("EFloud Lab", "EFloud Lab", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 1000)

// =============================================================================
// EFloud Pine Lab — CORE (single source: pine/lab/core.pine)
// Spec: docs/superpowers/specs/2026-11-05-pine-lab-design.md
// Baseline (all toggles OFF) = live SMC v2 entry logic (engine/smc_v2/luxalgo.py,
