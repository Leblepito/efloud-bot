# efloud advisory research cycle — zamanlayıcı
#
# Kurulum: bkz. deploy/research-cycle.service başlığı ve docs/runbooks/research-cycle.md
#
# Kadans: OnBootSec=5min (boot'tan 5 dk sonra bir kez) + OnUnitActiveSec=5h
# (son koşudan 5 saat sonra). Persistent=true → VPS kapalı/reboot olduysa
# kaçırılan koşu açılışta telafi edilir.

[Unit]
Description=Run the efloud advisory research cycle every 5 hours
Documentation=file:/opt/efloud-bot/docs/runbooks/research-cycle.md

[Timer]
OnBootSec=5min
OnUnitActiveSec=5h
Persistent=true
Unit=research-cycle.service
# Boot'ta servisler oturana kadar bekle (bot/autoheal ile çakışmasın).
AccuracySec=1min

[Install]
WantedBy=timers.target
