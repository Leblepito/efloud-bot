# .env.research — SADECE advisory research cycle (TradingAgents) için.
#
# Kopyala:  cp deploy/.env.research.example /opt/efloud-bot/.env.research && chmod 600 /opt/efloud-bot/.env.research
#
# ⛔ .env.production ASLA kullanılmaz. Orada Binance API anahtarları var ve
#    TradingAgents güvenilmeyen haber/sosyal medya metnini LLM'e veriyor.
#    Bu dosyada yalnız LLM anahtarı (ve opsiyonel veri anahtarı) bulunur.
#
# Kullanan: deploy/research-cycle.sh → docker run --env-file .env.research
#           (repo read-only mount; yalnız desk/ yazılabilir)

# Zorunlu — açık anahtar (OpenRouter). Anahtar yoksa runner FATAL ile durur.
OPENROUTER_API_KEY=

# Opsiyonel — TradingAgents'in makro veri sağlayıcısı (FRED) erişimi.
# FRED_API_KEY=

# Model katmanları — research_cycle.py VE tradingagents_brief.py ikisi de okur.
# Kod varsayılanı: quick=deepseek/deepseek-v4.1-flash, deep=deepseek/deepseek-v4-pro (ücretli).
# Operatör kararı 2026-11-04: araştırma döngüsü ÜCRETSİZ Nemotron ile çalışsın.
# Kimliği OpenRouter'dan DOĞRULAMADAN yazma (ücretsiz varyant genelde ':free' ekli):
#   curl -s https://openrouter.ai/api/v1/models | python3 -c "import sys,json;\
#   [print(m['id'], 'tools' in m.get('supported_parameters',[]), m['pricing']['prompt']) for m in json.load(sys.stdin)['data'] if 'nemotron-3-ultra' in m['id']]"
#   -> fiyatı 0 olan VE tools=True olan kimliği seç (TradingAgents analistleri tool calling kullanır).
# TRADINGAGENTS_LLM_PROVIDER=openrouter
# TRADINGAGENTS_QUICK_THINK_LLM=<doğrulanmış ücretsiz nemotron kimliği>
# TRADINGAGENTS_DEEP_THINK_LLM=<doğrulanmış ücretsiz nemotron kimliği>

# Yanıt başına token tavanı (varsayılan 8192). Tavan yoksa model maksimumu (131072)
# istenir ve OpenRouter kredi ayırmaya çalışır -> HTTP 402. Reasoning modeller düşünme
# token'larını da buna sayar; çıktı kesik geliyorsa 12000-16000'e çıkar.
# TRADINGAGENTS_MAX_TOKENS=8192
