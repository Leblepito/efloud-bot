# .env.research — SADECE advisory research cycle (TradingAgents) için.
#
# Kopyala:  cp deploy/.env.research.example /opt/efloud-bot/.env.research && chmod 600 /opt/efloud-bot/.env.research
#
# ⛔ .env.production ASLA kullanılmaz. Orada Binance API anahtarları var ve
#    TradingAgents güvenilmeyen haber/sosyal medya metnini LLM'e veriyor.
#    Bu dosyada yalnız LLM anahtarı (ve opsiyonel veri anahtarı) bulunur.
#
# Kullanan: deploy/research-cycle.sh → docker run --env-file .env.research
#           (repo read-only mount; yalnız desk/ yazılabilir)

# Zorunlu — açık anahtar (OpenRouter). Anahtar yoksa runner FATAL ile durur.
OPENROUTER_API_KEY=

# Opsiyonel — TradingAgents'in makro veri sağlayıcısı (FRED) erişimi.
# FRED_API_KEY=

# Opsiyonel — model katmanlarını ezmek için (varsayılanlar openrouter):
# TRADINGAGENTS_LLM_PROVIDER=openrouter
# TRADINGAGENTS_QUICK_THINK_LLM=deepseek/deepseek-v4.1-flash
# TRADINGAGENTS_DEEP_THINK_LLM=deepseek/deepseek-v4-pro
