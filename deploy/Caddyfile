# ── Birleşik çoklu-bot izleme paneli (Faz 1, 2026-07-24) ───────────
# 3 botun API'lerini server-side aggregate eden panel (efloud-panel:8090).
# Basic auth panelin kendisinde (DASHBOARD_PASSWORD); TLS Caddy'de.
panel.178-104-122-91.nip.io {
    encode gzip zstd
    reverse_proxy efloud-panel:8090 {
        header_up X-Real-IP {remote_host}
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer-when-downgrade"
    }
