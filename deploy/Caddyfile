# ── Lato Çeviri PTT Web App ─────────────────────────────────────────
# Push-to-talk translation web app (Thai ↔ Turkish ↔ English)
# Host server runs on host port 8088, Caddy reaches it via host gateway IP.
translate.178-104-122-91.nip.io {
    encode gzip zstd
    reverse_proxy lato-translator:8088 {
        header_up X-Real-IP {remote_host}
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer-when-downgrade"
    }
}

