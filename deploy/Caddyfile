# Caddyfile — auto-HTTPS reverse proxy for efloud-bot
# nip.io: any subdomain like 178-104-122-91.nip.io → resolves to 178.104.122.91
# Caddy auto-provisions a Let's Encrypt cert via TLS-ALPN-01 (port 443)
# and uses port 80 for HTTP→HTTPS redirects + HTTP-01 fallback.
# Both 80 and 443 must be open in UFW.

{
    # Global options
    email utkucanuysall@gmail.com  # used by ACME (LE) for cert expiry warnings
}
bot.u2algo.com, bot.ualgotrade.com, 178-104-122-91.nip.io {
    encode gzip zstd
    reverse_proxy efloud-bot:8080 {
        header_up X-Real-IP {remote_host}
    }

    # Security headers (HTTPS-only)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer-when-downgrade"
    }
}

# V2 long-bot dashboard (efloud-bot-long).
# v2.u2algo.com: Cloudflare DNS A-record → 178.104.122.91; cert otomatik.
v2.u2algo.com, v2.178-104-122-91.nip.io {
    encode gzip zstd
    reverse_proxy efloud-bot-long:8080 {
        header_up X-Real-IP {remote_host}
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer-when-downgrade"
    }
}

