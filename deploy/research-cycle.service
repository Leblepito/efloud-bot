# efloud advisory research cycle — 5 saatlik döngü (systemd unit'i)
#
# Kurulum (VPS):
#   cp deploy/research-cycle.service /etc/systemd/system/
#   cp deploy/research-cycle.timer   /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now research-cycle.timer
#   systemctl list-timers research-cycle.timer
#
# Elle bir koşu:
#   systemctl start research-cycle.service
#   journalctl -u research-cycle.service -n 50 --no-pager
#
# ADVISORY ONLY: üretilen brief'ler emir/sizing/SL/TP girdisi DEĞİLDİR.

[Unit]
Description=efloud advisory research cycle (LuxAlgo MTF structure + TradingAgents brief)
Documentation=file:/opt/efloud-bot/docs/runbooks/research-cycle.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/efloud-bot
ExecStart=/opt/efloud-bot/deploy/research-cycle.sh
# TradingAgents bir koşuda çok sayıda LLM çağrısı yapar. Ölçüm 2026-11-04: ücretsiz
# Nemotron ile BTC tek sembol 13 dk 14 sn; varsayılan BTC+ETH ~27 dk -> 60 dk tavan.
TimeoutStartSec=3600
# systemd zaman aşımında/stop'ta yalnız `docker run` istemcisini öldürür; konteyner
# yaşamaya (ve LLM kredisi harcamaya) devam edebilir, sonraki koşu --name çakışmasına
# düşer. Servis her durduğunda konteyneri kaldır ("-" = konteyner yoksa hata sayma).
ExecStopPost=-/usr/bin/docker rm -f efloud-research-run
# Bir sonraki timer tick'ine sarkarsa iptal et (systemd aynı unit'i üst üste başlatmaz).
Nice=10
# Loglar: journal + repo içi dosya (logs/ gitignore'lu).
StandardOutput=append:/opt/efloud-bot/logs/research_cycle.log
StandardError=append:/opt/efloud-bot/logs/research_cycle.log
