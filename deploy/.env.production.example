# Efloud Bot — Hetzner Production Env
# Sunucuda: cp .env.production.example .env.production && nano .env.production

# ── Binance Mainnet (Futures) ──
BINANCE_API_KEY=PASTE_MAINNET_KEY_HERE
BINANCE_API_SECRET=PASTE_MAINNET_SECRET_HERE
EFLOUD_ALLOW_MAINNET=1

# ── Bot config ──
EFLOUD_CONFIG_PATH=configs/config.phase2_1k.yaml
EFLOUD_AUTOSTART=0          # 0 = ilk deploy'da manuel start, stabilize olunca 1 yap
EFLOUD_AUTO_MIGRATE=0       # DB persist devre dışı (Supabase pooler sorunu çözülünce 1 yap)

# ── Web dashboard ──
DASHBOARD_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32CHARS_MIN
SESSION_SECRET=CHANGE_ME_RANDOM_32_HEX_CHARS

# ── DB (şimdilik kapalı) ──
# DATABASE_URL=postgresql://postgres.PROJECT:PASS@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ── CORS ──
# Erişim Caddy reverse-proxy üzerinden HTTPS olduğu için origin tek satır:
#   https://<HYPHENATED_IP>.nip.io  (örn: 178-104-122-91.nip.io)
# Kendi domain'in varsa onu da ekle, virgülle ayır.
ALLOWED_ORIGINS=https://HYPHENATED_IP.nip.io

# ── Runtime ──
# ENV=production → cookie Secure flag açık (sadece HTTPS).
# HTTPS olmadan dashboard'a erişiyorsan ENV=dev yap (geçici, güvensiz).
ENV=production
LOG_LEVEL=INFO
