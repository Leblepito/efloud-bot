# ── efloud-bot LONG instance (v2-long) production env ────────────────────────
# Kopyala: cp deploy/.env.production.long.example .env.production.long
# Sonra key'leri doldur. Bu dosya ASLA commit edilmez.
# (docker-compose.prod.yml `efloud-bot-long` servisi bu dosyayı bekler;
#  şablon 2026-06-20 handoff'unda vaat edilip hiç eklenmemişti.)

# Long cüzdanının KENDİ API key'i (V1/V3 cüzdanlarıyla PAYLAŞMA — pozisyon
# modu cüzdan-genelidir, iki bot aynı cüzdanda çatışır)
BINANCE_API_KEY=PASTE_LONG_WALLET_KEY_HERE
BINANCE_API_SECRET=PASTE_LONG_WALLET_SECRET_HERE

EFLOUD_CONFIG_PATH=configs/config.phase2_long_1k.yaml
EFLOUD_BOT_ID=v2-long

# Güvenli başlangıç: bot deploy'da OTOMATİK trade etmez; dashboard'dan Start.
EFLOUD_AUTOSTART=0
EFLOUD_ALLOW_MAINNET=1

# Dashboard login şifresi — birleşik panel üç bota da TEK şifreyle login
# olduğu için .env.production (V1) ile AYNI olmalı. Rotasyon:
# ./deploy/rotate-credentials.sh (üç dosyayı senkron günceller).
DASHBOARD_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32CHARS_MIN

# Dashboard oturumu (openssl rand -hex 32 ile üret — diğer instance'larla farklı)
SESSION_SECRET=CHANGE_ME_RANDOM_32_HEX_CHARS
# ENV=production → cookie Secure flag açık (sadece HTTPS)
ENV=production

# Edge ölçümü (opsiyonel — long sinyallerini de ledger'a yazar)
# EFLOUD_SIGNAL_LEDGER_ENABLED=1
