# ── efloud-bot SCALP instance (v3-scalp) production env ──────────────────────
# Kopyala: cp deploy/.env.production.scalp.example .env.production.scalp
# Sonra key'leri doldur. Bu dosya ASLA commit edilmez.

# Scalp cüzdanının KENDİ API key'i (V1/V2 cüzdanlarıyla PAYLAŞMA — pozisyon
# modu cüzdan-genelidir, iki bot aynı cüzdanda çatışır)
BINANCE_API_KEY=PASTE_SCALP_WALLET_KEY_HERE
BINANCE_API_SECRET=PASTE_SCALP_WALLET_SECRET_HERE

EFLOUD_CONFIG_PATH=configs/config.phase2_scalp_1k.yaml
EFLOUD_BOT_ID=v3-scalp

# Güvenli başlangıç: bot deploy'da OTOMATİK trade etmez; dashboard'dan Start.
EFLOUD_AUTOSTART=0
EFLOUD_ALLOW_MAINNET=1

# Dashboard oturumu (openssl rand -hex 32 ile üret — diğer instance'larla farklı)
SESSION_SECRET=CHANGE_ME_RANDOM_32_HEX_CHARS
# ENV=production → cookie Secure flag açık (sadece HTTPS)
ENV=production

# Edge ölçümü (opsiyonel — scalp sinyallerini de ledger'a yazar)
# EFLOUD_SIGNAL_LEDGER_ENABLED=1
